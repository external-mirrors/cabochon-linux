		smi_larb2: larb@3e030000 {
			compatible = "mediatek,mt8196-smi-larb";
			reg = <0 0x3e030000 0 0x1000>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_MML0_SHUTDOWN>;
