			reg = <0 0x3e820000 0 0x1000>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DISP_VCORE>;
			clocks = <&vdisp_ao CLK_MM_V_SMI_SUB_SOMM0>,
