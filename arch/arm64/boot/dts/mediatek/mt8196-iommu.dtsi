		};

		smi_larb3: larb@3e430000 {
			compatible = "mediatek,mt8196-smi-larb";
			reg = <0 0x3e430000 0 0x1000>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_MML1_SHUTDOWN>;
			clocks = <&mdpsys1 CLK_MDP1_SMI0>, <&mdpsys1 CLK_MDP1_SMI0>;
			clock-names = "apb", "smi";
			mediatek,smi = <&smi_mdp_dram_sub_comm3>;
			mediatek,larb-id = <3>;
			larb-port-real-time-type = <2 2 2 2 2 2 2 2 1 2 2 2 2 2 2 2 1 2>;
		};

		smi_disp_dram_sub_comm0: smi-sub-comm@3e810000 {
