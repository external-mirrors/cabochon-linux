			clock-names = "apb", "smi";
			mediatek,smi = <&smi_mdp_common>;
			mediatek,common-id = <16>;
		};

		smi_larb42: larb@38890000 {
			compatible = "mediatek,mt8196-smi-larb";
			reg = <0 0x38890000 0 0x1000>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_VEN1>;
			clocks = <&vencsys1 CLK_VEN2_CKE0_LARB>,
				 <&vencsys1 CLK_VEN2_CKE1_VENC>;
			clock-names = "apb", "smi";
			mediatek,smi = <&smi_mdp_venc_sub_comm1>;
			mediatek,larb-id = <42>;
			larb-port-real-time-type = <3 3 3 3 3 3 3 1 1 1 3 3 3 3 3 3 1 1 1 3 3 3 3 3 3 3 3 1 1 1 1 3>;
		};

		smi_larb24: larb@38c10000 {
			compatible = "mediatek,mt8196-smi-larb";
			reg = <0 0x38c10000 0 0x1000>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_VEN2>;
			clocks = <&vencsys2 CLK_VEN_C2_CKE0_LARB>,
				 <&vencsys2 CLK_VEN_C2_CKE1_VENC>;
			clock-names = "apb", "smi";
			mediatek,smi = <&smi_mdp_venc_sub_comm2>;
			mediatek,larb-id = <24>;
			larb-port-real-time-type = <3 3 3 3 3 3 3 1 1 1 3 3 3 3 3 3 1 1 1 3 3 3 3 3 3 3 3 1 1 1 1 3>;
		};

		smi_mdp_venc_sub_comm2: smi-sub-comm@38c70000 {
			compatible = "mediatek,mt8196-smi-sub-common";
			reg = <0 0x38c70000 0 0x1000>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_VEN2>;
			clocks = <&vencsys2 CLK_VEN_C2_CKE0_LARB>,
				 <&vencsys2 CLK_VEN_C2_CKE1_VENC>;
			clock-names = "apb", "smi";
			mediatek,smi = <&smi_mdp_venc_sub_comm1>;
			mediatek,common-id = <18>;
		};

		smi_larb47: larb@38c90000 {
