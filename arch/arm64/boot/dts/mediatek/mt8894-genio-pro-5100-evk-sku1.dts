/dts-v1/;

#include "mt8894-genio-pro-5100-evk-common.dtsi"

/ {
	model = "MediaTek Genio Pro 5100 EVK SKU1";
	compatible = "mediatek,mt8894-evk-sku1", "mediatek,mt8894",
		     "mediatek,mt8196";

	/* separately switched 3.3V power rail */
	vusb33: regulator-vusb33 {
		compatible = "regulator-fixed";
		regulator-name = "vusb33";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&pio 251 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_vusb33_pins>;
		vin-supply = <&vsys_5v>;
	};
};

&eth_phy0 {
	/*
	 * Board-specific hack, needed due to a schematics error
	 * (AVDD10 supplies of both Ethernet PHYs are connected
	 * even though they shouldn't)
	 */
	phy-supply = <&veth_3v3>;
};

&i2c6 {
	usb3_repeater: repeater@4b {
		compatible = "nxp,ptn3222";
		reg = <0x4b>;
		#phy-cells = <0>;
		reset-gpios = <&pio 216 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb3_repeater_pins>;
		vdd3v3-supply = <&vusb33>;
		vdd1v8-supply = <&mt6363_vio18>;
	};
};

&i2c9 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c9_pins>;
	status = "okay";

	usb0_repeater: repeater@4f {
		compatible = "nxp,ptn3222";
		reg = <0x4f>;
		#phy-cells = <0>;
		reset-gpios = <&pio 72 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb0_repeater_pins>;
		vdd3v3-supply = <&vusb33>;
		vdd1v8-supply = <&mt6363_vio18>;
	};
};

&pio {
	i2c9_pins: i2c9-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO202__FUNC_SCL9>,
				 <PINMUX_GPIO203__FUNC_SDA9>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	usb_vusb33_pins: usb-vusb33-default {
		pins-regulator {
			pinmux = <PINMUX_GPIO251__FUNC_GPIO251>;
			output-high;
		};
	};
};

&usb1_repeater {
	vdd3v3-supply = <&vusb33>;
};

&usb2_repeater {
	vdd3v3-supply = <&vusb33>;
};
