/dts-v1/;

#include "mt8894-genio-pro-5100-evk-common.dtsi"
#include <dt-bindings/usb/pd.h>

/ {
	model = "MediaTek Genio Pro 5100 EVK SKU1";
	compatible = "mediatek,mt8894-evk-sku1", "mediatek,mt8894",
		     "mediatek,mt8196";

	/* separately switched 3.3V power rail */
	vusb33: regulator-vusb33 {
		compatible = "regulator-fixed";
		regulator-name = "vusb33";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&pio 251 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb_vusb33_pins>;
		vin-supply = <&vsys_5v>;
	};
};

&connector_hdmi0_in {
	remote-endpoint = <&it6162_out>;
};

&eth_phy0 {
	/*
	 * Board-specific hack, needed due to a schematics error
	 * (AVDD10 supplies of both Ethernet PHYs are connected
	 * even though they shouldn't)
	 */
	phy-supply = <&veth_3v3>;
};

&hdmi_bridge_it6162 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;
			it6162_in: endpoint {
				/* remote-endpoint = <&dsi0_out>; */
			};
		};

		port@2 {
			reg = <2>;
			it6162_out: endpoint {
				remote-endpoint = <&connector_hdmi0_in>;
			};
		};
	};
};

&hdmi_bridge_pins {
	/*
	 * GPIO136 has no EINT so, unfortunately, this cannot be used as the
	 * HPD interrupt... Park it in GPIO mode to reduce power leakage.
	 */
	pins-int {
		pinmux = <PINMUX_GPIO136__FUNC_GPIO136>;
		input-enable;
		bias-disable;
	};
};

&i2c6 {
	usb3_repeater: repeater@4b {
		compatible = "nxp,ptn3222";
		reg = <0x4b>;
		#phy-cells = <0>;
		reset-gpios = <&pio 216 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb3_repeater_pins>;
		vdd3v3-supply = <&vusb33>;
		vdd1v8-supply = <&mt6363_vio18>;
	};
};

&i2c9 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c9_pins>;
	status = "okay";

	/* Richtek RT1715 USB Type-C PD controller */
	rt1715: typec@4e {
		compatible = "richtek,rt1715";
		reg = <0x4e>;
		interrupts-extended = <&pio 141 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&rt1715_pins>;
		vbus-supply = <&vbus_usb0>;
		wakeup-source;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "source";
			pd-revision = /bits/ 8 <0x03 0x00 0x01 0x08>;
			source-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_USB_COMM | PDO_FIXED_DATA_SWAP)>;

			altmodes {
				displayport {
					svid = /bits/ 16 <0xff01>;
					vdo = <0x001c1c47>;
				};
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec_con_hs: endpoint {
						remote-endpoint = <&ssusb0_role_sw>;
					};
				};

				port@1 {
					reg = <1>;
					typec_con_ss: endpoint {
						remote-endpoint = <&xhci_ss_ep>;
					};
				};

				port@2 {
					reg = <2>;
					typec_con_out: endpoint {
						remote-endpoint = <&typec_mux_in>;
					};
				};
			};
		};
	};

	usb0_repeater: repeater@4f {
		compatible = "nxp,ptn3222";
		reg = <0x4f>;
		#phy-cells = <0>;
		reset-gpios = <&pio 72 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb0_repeater_pins>;
		vdd3v3-supply = <&vusb33>;
		vdd1v8-supply = <&mt6363_vio18>;
	};

	/*
	 * U5703: TI TS3USBCA410IRSVT USB 3.0/DP SBU orientation switch.
	 * Controls SBU1/SBU2 and DP_AUX lane routing based on plug orientation.
	 * LnA is connected to DP_AUXP/DP_AUXN from the SoC.
	 */
	typec-mux@5d {
		compatible = "ti,ts3usbca4";
		reg = <0x5d>;

		mode-switch;
		orientation-switch;

		enable-gpios = <&pio 142 GPIO_ACTIVE_HIGH>;
		vcc-supply = <&vsys_3v3>;
		pinctrl-names = "default";
		pinctrl-0 = <&typec_mux_pins>;

		port {
			typec_mux_in: endpoint {
				remote-endpoint = <&typec_con_out>;
			};
		};
	};
};

&pio {
	i2c9_pins: i2c9-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO202__FUNC_SCL9>,
				 <PINMUX_GPIO203__FUNC_SDA9>;
			bias-disable;
			drive-strength = <4>;
		};
	};

	fan_tach_pins: fan-tach-pins {
		tach-pins {
			pinmux = <PINMUX_GPIO35__FUNC_GPIO35>;
			bias-pull-up;
			input-enable;
		};
	};

	usb_vusb33_pins: usb-vusb33-default {
		pins-regulator {
			pinmux = <PINMUX_GPIO251__FUNC_GPIO251>;
			output-high;
		};
	};

	vio18_lcm1_pins: vio18-lcm1-default {
		pins-regulator {
			pinmux = <PINMUX_GPIO93__FUNC_GPIO93>;
			bias-pull-up;
			drive-strength = <8>;
			output-high;
		};
	};

	vio33_tp1_lcm1_pins: vio33-tp1-lcm1-default {
		pins-regulator {
			pinmux = <PINMUX_GPIO92__FUNC_GPIO92>;
			bias-pull-up;
			drive-strength = <8>;
			output-high;
		};
	};

	vsys_lcm1_pins: vsys-lcm1-default {
		pins-regulator {
			pinmux = <PINMUX_GPIO91__FUNC_GPIO91>;
			bias-pull-up;
			drive-strength = <8>;
			output-high;
		};
	};
};

&soc_fan {
	pinctrl-names = "default";
	pinctrl-0 = <&fan_tach_pins>;
	interrupts-extended = <&pio 35 IRQ_TYPE_EDGE_RISING>;
};


&usb1_repeater {
	vdd3v3-supply = <&vusb33>;
};

&usb2_repeater {
	vdd3v3-supply = <&vusb33>;
};

&vio18_lcm1 {
	gpio = <&pio 93 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&vio18_lcm1_pins>;
};

&vio33_tp1_lcm1 {
	gpio = <&pio 92 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&vio33_tp1_lcm1_pins>;
};

&vsys_lcm1 {
	gpio = <&pio 91 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&vsys_lcm1_pins>;
};

&vvideo_5v_pins {
	pins-regulator {
		pinmux = <PINMUX_GPIO36__FUNC_GPIO36>;
		bias-pull-up;
	};
};

&vvideo_5v {
	gpio = <&pio 36 GPIO_ACTIVE_HIGH>;
};
