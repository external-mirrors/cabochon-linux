/dts-v1/;
#include "mt8196-rauru.dtsi"
#include <dt-bindings/thermal/thermal.h>

/ {
	pp3300_edp_x: regulator-pp3300-edp-x {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_edp_x";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&pio 172 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&pp3300_edp_pin>;
		vin-supply = <&mt6373_vcn33_3>;
	};

	pp1000_dpbrdg: regulator-pp1000-dpbrdg {
		compatible = "regulator-fixed";
		regulator-name = "pp1000_dpbrdg";
		pinctrl-names = "default";
		pinctrl-0 = <&pp1000_dpbrdg_pin>;
		enable-active-high;
		regulator-boot-on;
		gpio = <&pio 82 GPIO_ACTIVE_HIGH>;
		vin-supply = <&pp3300_z1>;
	};

	pp1800_dpbrdg: regulator-pp1800-dpbrdg-dx {
		compatible = "regulator-fixed";
		regulator-name = "pp1800_dpbrdg_dx";
		pinctrl-names = "default";
		pinctrl-0 = <&pp1800_dpbrdg_pin>;
		enable-active-high;
		regulator-boot-on;
		gpio = <&pio 84 GPIO_ACTIVE_HIGH>;
		vin-supply = <&mt6363_vio18>;
	};

	pp3300_dpbrdg: regulator-pp3300-dp-dx {
		compatible = "regulator-fixed";
		regulator-name = "pp3300_dpbrdg";
		pinctrl-names = "default";
		pinctrl-0 = <&pp3300_dpbrdg_pin>;
		enable-active-high;
		regulator-boot-on;
		gpio = <&pio 83 GPIO_ACTIVE_HIGH>;
		vin-supply = <&pp3300_z1>;
	};
};

&i2c0 {
	/* focal trackpad */
	trackpad@38 {
		compatible = "hid-over-i2c";
		reg = <0x38>;
		hid-descr-addr = <0x0020>;
		interrupts-extended = <&pio 8 IRQ_TYPE_LEVEL_LOW>;
		vdd-supply = <&mt6373_vcn33_2>;
		wakeup-source;
	};
};

&i2c2 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pins>;

	touchscreen: touchscreen@14 {
		compatible = "goodix,gt7986u", "goodix,gt7375p";
		reg = <0x14>;
		interrupts-extended = <&pio 7 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&touchscreen_pins>;
		reset-gpios = <&pio 31 GPIO_ACTIVE_LOW>;
		vdd-supply = <&mt6373_vtp>;
		status = "disabled";
	};
};

&i2c4 {
	anx_bridge: anx7625@58 {
		compatible = "analogix,anx7625";
		reg = <0x58>;
		pinctrl-names = "default";
		pinctrl-0 = <&anx7625_pins>;
		enable-gpios = <&pio 81 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pio 86 GPIO_ACTIVE_HIGH>;
		interrupts-extended = <&pio 14 IRQ_TYPE_LEVEL_LOW>;
		vdd10-supply = <&pp1000_dpbrdg>;
		vdd18-supply = <&pp1800_dpbrdg>;
		vdd33-supply = <&pp3300_dpbrdg>;
		analogix,audio-enable;
		#sound-dai-cells = <0>;

		connector {
			compatible = "usb-c-connector";
			power-role = "dual";
			data-role = "dual";
			vbus-supply = <&pp5000_usb>;

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					anx7625_hs: endpoint {
						remote-endpoint = <&usb_hs>;
					};
				};

				port@1 {
					reg = <1>;
					anx7625_ss: endpoint {
						remote-endpoint = <&usb_ss>;
					};
				};

				port@2 {
					reg = <2>;
					anx7625_sbu: endpoint {
						remote-endpoint = <&typec0_sbu>;
					};
				};
			};
		};

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;

				anx7625_dp_in: endpoint {
					data-lanes = <0 1 2 3>;
					remote-endpoint = <&dsi0_out>;
				};
			};

		};
	};
};

&ssusb0 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			usb_hs: endpoint {
				remote-endpoint = <&anx7625_hs>;
			};
		};

		port@1 {
			reg = <1>;
			usb_ss: endpoint {
				remote-endpoint = <&anx7625_ss>;
			};
		};
	};
};

&usb_c0 {
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@1 {
			reg = <1>;

			typec0_sbu: endpoint {
				remote-endpoint = <&anx7625_sbu>;
			};
		};
	};
};

&dsc2_out {
	remote-endpoint = <&dsi0_in>;
};

&dsi0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			dsi0_in: endpoint@3 {
				reg = <3>;
				remote-endpoint = <&dsc2_out>;
			};
		};

		port@1 {
			reg = <1>;
			dsi0_out: endpoint {
				remote-endpoint = <&anx7625_dp_in>;
			};
		};
	};
};

&mipi_tx_config0 {
	status = "okay";
};

&backlight {
	status = "disabled";
};

&panel {
	compatible = "samsung,atna33xc20";
	enable-gpios = <&pio 216 GPIO_ACTIVE_HIGH>;
	power-supply = <&pp3300_edp_x>;
	/delete-property/ backlight;
};

&thermal_zones {
	bulk-board-thermal {
		polling-delay = <1000>;
		polling-delay-passive = <1000>;
		thermal-sensors = <&cros_ec 0>;
		sustainable-power = <3350>; /* estimated sustainable power when saturated */

		trips {
			bulk_threshold: trip-point@0 {
				temperature = <40000>; /* switch on temperature */
				hysteresis = <2000>;
				type = "passive";
			};
			bulk_target: trip-point@1 {
				temperature = <50000>; /* desired temperature */
				hysteresis = <2000>;
				type = "passive";
			};
		};

		cooling-maps {
			map0 {
				trip = <&bulk_target>;
				cooling-device =
					<&cpu0 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&cpu1 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&cpu2 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&cpu3 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				contribution = <2048>;
			};
			map1 {
				trip = <&bulk_target>;
				cooling-device =
					<&cpu4 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&cpu5 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>,
					<&cpu6 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				contribution = <1024>;
			};
			map2 {
				trip = <&bulk_target>;
				cooling-device =
					<&cpu7 THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				contribution = <768>;
			};
			map3 {
				trip = <&bulk_target>;
				cooling-device =
					<&gpu THERMAL_NO_LIMIT THERMAL_NO_LIMIT>;
				contribution = <1024>;
			};
		};
	};

	cpu-board-thermal {
		polling-delay = <0>;
		polling-delay-passive = <0>;
		thermal-sensors = <&cros_ec 1>;

		trips {
			cpu_board_trip0: trip-point@0 {
				temperature = <80000>;
				hysteresis = <2000>;
				type = "hot";
			};
		};
	};

	charger-thermal {
		polling-delay = <0>;
		polling-delay-passive = <0>;
		thermal-sensors = <&cros_ec 2>;

		trips {
			charger_trip0: trip-point@0 {
				temperature = <80000>;
				hysteresis = <2000>;
				type = "hot";
			};
		};
	};
};

&keyboard_controller {
	function-row-physmap = <
		MATRIX_KEY(0x00, 0x02, 0)		/* T1 */
		MATRIX_KEY(0x03, 0x02, 0)		/* T2 */
		MATRIX_KEY(0x02, 0x02, 0)		/* T3 */
		MATRIX_KEY(0x01, 0x02, 0)		/* T4 */
		MATRIX_KEY(0x04, 0x04, 0)		/* T5 */
		MATRIX_KEY(0x02, 0x04, 0)		/* T6 */
		MATRIX_KEY(0x01, 0x04, 0)		/* T7 */
		MATRIX_KEY(0x02, 0x0b, 0)		/* T8 */
		MATRIX_KEY(0x01, 0x09, 0)		/* T9 */
		MATRIX_KEY(0x00, 0x04, 0)		/* T10 */
		MATRIX_KEY(0x00, 0x01, 0)		/* T11 */
		MATRIX_KEY(0x01, 0x05, 0)		/* T12 */
		MATRIX_KEY(0x03, 0x05, 0)		/* T13 */
		MATRIX_KEY(0x00, 0x0b, 0)		/* T14 */
	>;

	keypad,num-columns = <18>;

	linux,keymap = <
		CROS_TOP_ROW_KEYMAP_V30
		CROS_MAIN_KEYMAP_V30

		MATRIX_KEY(0x00, 0x02, KEY_BACK)		/* T1 */
		MATRIX_KEY(0x03, 0x02, KEY_REFRESH)		/* T2 */
		MATRIX_KEY(0x02, 0x02, KEY_ZOOM)		/* T3 */
		MATRIX_KEY(0x01, 0x02, KEY_SCALE)		/* T4 */
		MATRIX_KEY(0x04, 0x04, KEY_SYSRQ)		/* T5 */
		MATRIX_KEY(0x02, 0x04, KEY_BRIGHTNESSDOWN)	/* T6 */
		MATRIX_KEY(0x01, 0x04, KEY_BRIGHTNESSUP)	/* T7 */
		MATRIX_KEY(0x02, 0x0b, KEY_KBDILLUMTOGGLE)	/* T8 */
		MATRIX_KEY(0x01, 0x09, KEY_MICMUTE)		/* T9 */
		MATRIX_KEY(0x00, 0x04, KEY_MUTE)		/* T10 */
		MATRIX_KEY(0x00, 0x01, KEY_VOLUMEDOWN)		/* T11 */
		MATRIX_KEY(0x01, 0x05, KEY_VOLUMEUP)		/* T12 */
		MATRIX_KEY(0x03, 0x05, KEY_ACCESSIBILITY)	/* T13 */
		MATRIX_KEY(0x00, 0x0b, KEY_DICTATE)		/* T14 */
	>;
};

&pio {
	anx7625_pins: anx7625-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO81__FUNC_GPIO81>,
				 <PINMUX_GPIO86__FUNC_GPIO86>;
			output-low;
		};

		pins-in {
			pinmux = <PINMUX_GPIO14__FUNC_GPIO14>;
			input-enable;
			bias-pull-up;
		};
	};

	pp3300_edp_pin: pp3300-edp-pins {
		pins-en {
			pinmux = <PINMUX_GPIO172__FUNC_GPIO172>;
			output-high;
		};
	};

	pp1000_dpbrdg_pin: pp1000-dpbrdg-pins {
		pins-en {
			pinmux = <PINMUX_GPIO82__FUNC_GPIO82>;
			output-low;
		};
	};

	pp1800_dpbrdg_pin: pp1800-dpbrdg-pins {
		pins-en {
			pinmux = <PINMUX_GPIO84__FUNC_GPIO84>;
			output-low;
		};
	};

	pp3300_dpbrdg_pin: en-pp3300-dpbrdg-pins {
		pins-en {
			pinmux = <PINMUX_GPIO83__FUNC_GPIO83>;
			output-low;
		};
	};
};
