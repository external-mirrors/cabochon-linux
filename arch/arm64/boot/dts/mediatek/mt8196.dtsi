		imp_iic_wrap_north: clock-controller@13c30000 {
			compatible = "mediatek,mt8196-imp-iic-wrap-n", "syscon";
			reg = <0 0x13c30000 0 0x1000>;
			mediatek,hardware-voter = <&scp_hwv>;
			#clock-cells = <1>;
		};

		lvts_ap: thermal-sensor@14414000 {
			compatible = "mediatek,mt8196-lvts-ap";
			reg = <0 0x14414000 0 0x1000>;
			interrupts = <GIC_SPI 358 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>;
			nvmem-cells = <&lvts_efuse_data1 &lvts_efuse_data2
				       &lvts_efuse_data3 &lvts_efuse_data4>;
			nvmem-cell-names = "lvts-calib-data-1","lvts-calib-data-2",
					   "lvts-calib-data-3","lvts-calib-data-4";
			#thermal-sensor-cells = <1>;
		};

		scp_hwv: system-controller@14500000 {
			compatible = "mediatek,mt8196-scpsys", "syscon", "simple-mfd";
			reg = <0 0x14500000 0 0x3000>;

			/* SCP Power Manager with Hardware Voter */
			spm_hwv: power-controller {
				compatible = "mediatek,mt8196-hwv-scp-power-controller";
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <1>;

				/* SCPSYS hardware voter power domains */
				power-domain@MT8196_POWER_DOMAIN_MM_PROC_DORMANT {
					reg = <MT8196_POWER_DOMAIN_MM_PROC_DORMANT>;
					#power-domain-cells = <0>;
				};

				power-domain@MT8196_POWER_DOMAIN_SSR {
					reg = <MT8196_POWER_DOMAIN_SSR>;
					#power-domain-cells = <0>;
				};
			};
		};

		uart0: serial@16000000 {
			compatible = "mediatek,mt8196-uart", "mediatek,mt6577-uart";
			reg = <0 0x16000000 0 0x1000>;
			interrupts = <GIC_SPI 311 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>, <&pericfg_ao CLK_PERI_AO_UART0_BCLK>;
			clock-names = "baud", "bus";
			dmas = <&apdma 0>, <&apdma 1>;
			dma-names = "tx", "rx";
			status = "disabled";
