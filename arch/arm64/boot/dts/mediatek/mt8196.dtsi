/dts-v1/;
#include <dt-bindings/clock/mediatek,mt8196-clock.h>
#include <dt-bindings/reset/mediatek,mt8196-resets.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/phy/phy.h>
#include <dt-bindings/power/mediatek,mt8196-power.h>
#include <dt-bindings/reset/mediatek,mt8196-resets.h>
#include <dt-bindings/thermal/mediatek,lvts-thermal.h>
#include "mt8196-gce.h"
#include "mt8196-pinfunc.h"

/ {
	compatible = "mediatek,mt8196";
	interrupt-parent = <&gic>;
	#address-cells = <2>;
	#size-cells = <2>;

	aliases {
		blender0 = &ovl0_blender0;
		blender1 = &ovl0_blender1;
		blender2 = &ovl0_blender2;
		blender3 = &ovl0_blender3;
		blender4 = &ovl0_blender4;
		blender5 = &ovl0_blender5;
		blender6 = &ovl0_blender6;
		blender7 = &ovl0_blender7;
		blender8 = &ovl0_blender8;
		blender9 = &ovl0_blender9;
		blender10 = &ovl1_blender0;
		blender11 = &ovl1_blender1;
		blender12 = &ovl1_blender2;
		blender13 = &ovl1_blender3;
		blender14 = &ovl1_blender4;
		blender15 = &ovl1_blender5;
		blender16 = &ovl1_blender6;
		blender17 = &ovl1_blender7;
		blender18 = &ovl1_blender8;
		blender19 = &ovl1_blender9;
		ccorr0 = &ccorr0;
		ccorr1 = &ccorr1;
		ccorr2 = &ccorr2;
		ccorr3 = &ccorr3;
		dither0 = &dither0;
		dither1 = &dither1;
		dither2 = &disp1_dither2;
		dp-intf0 = &dp_intf0;
		dp-intf1 = &dp_intf1;
		dsc0 = &dsc0;
		dsc1 = &dsc1;
		dvo0 = &dvo0;
		exdma2 = &ovl0_exdma2;
		exdma3 = &ovl0_exdma3;
		exdma4 = &ovl0_exdma4;
		exdma5 = &ovl0_exdma5;
		exdma6 = &ovl0_exdma6;
		exdma7 = &ovl0_exdma7;
		exdma8 = &ovl0_exdma8;
		exdma9 = &ovl0_exdma9;
		exdma12 = &ovl1_exdma2;
		exdma13 = &ovl1_exdma3;
		exdma14 = &ovl1_exdma4;
		exdma15 = &ovl1_exdma5;
		exdma16 = &ovl1_exdma6;
		exdma17 = &ovl1_exdma7;
		exdma18 = &ovl1_exdma8;
		exdma19 = &ovl1_exdma9;
		gamma0 = &gamma0;
		gamma1 = &gamma1;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i2c6;
		i2c7 = &i2c7;
		i2c8 = &i2c8;
		i2c9 = &i2c9;
		i2c10 = &i2c10;
		i2c11 = &i2c11;
		i2c12 = &i2c12;
		i2c13 = &i2c13;
		i2c14 = &i2c14;
		mmc1 = &mmc1;
		mmc2 = &mmc2;
		mutex0 = &disp0_mutex;
		mutex1 = &disp1_mutex;
		mutex2 = &ovl0_mutex;
		mutex3 = &ovl1_mutex;
		outproc0 = &ovl0_outproc0;
		outproc1 = &ovl0_outproc1;
		outproc2 = &ovl0_outproc2;
		outproc3 = &ovl0_outproc3;
		outproc4 = &ovl0_outproc4;
		outproc5 = &ovl0_outproc5;
		outproc6 = &ovl1_outproc0;
		outproc7 = &ovl1_outproc1;
		outproc8 = &ovl1_outproc2;
		outproc9 = &ovl1_outproc3;
		outproc10 = &ovl1_outproc4;
		outproc11 = &ovl1_outproc5;
		postmask0 = &postmask0;
		postmask1 = &postmask1;
		resizer0 = &mdp_rsz0;
		resizer1 = &mdp_rsz1;
		resizer2 = &ovl0_rsz0;
		resizer4 = &ovl1_rsz0;
		spmi0 = &spmi0;
		spmi1 = &spmi1;
		tdshp0 = &tdshp0;
		tdshp1 = &tdshp1;
	};

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x000>;
			enable-method = "psci";
			capacity-dmips-mhz = <714>;
			clock-frequency = <2100000000>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &s2idle>;
			performance-domains = <&performance 0>;
			i-cache-size = <65536>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <65536>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
		};

		cpu1: cpu@100 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x100>;
			enable-method = "psci";
			capacity-dmips-mhz = <714>;
			clock-frequency = <2100000000>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &s2idle>;
			performance-domains = <&performance 0>;
			i-cache-size = <65536>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <65536>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
		};

		cpu2: cpu@200 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x200>;
			enable-method = "psci";
			capacity-dmips-mhz = <714>;
			clock-frequency = <2100000000>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &s2idle>;
			performance-domains = <&performance 0>;
			i-cache-size = <65536>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <65536>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
		};

		cpu3: cpu@300 {
			device_type = "cpu";
			compatible = "arm,cortex-a720";
			reg = <0x300>;
			enable-method = "psci";
			capacity-dmips-mhz = <714>;
			clock-frequency = <2100000000>;
			cpu-idle-states = <&cpuoff_l &clusteroff_l &s2idle>;
			performance-domains = <&performance 0>;
			i-cache-size = <65536>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <65536>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&l2_0>;
			#cooling-cells = <2>;
		};

		cpu4: cpu@400 {
			device_type = "cpu";
			compatible = "arm,cortex-x4";
			reg = <0x400>;
			enable-method = "psci";
			capacity-dmips-mhz = <835>;
			clock-frequency = <2800000000>;
			cpu-idle-states = <&cpuoff_m &clusteroff_m &s2idle>;
			performance-domains = <&performance 1>;
			i-cache-size = <65536>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <65536>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&l2_1>;
			#cooling-cells = <2>;
		};

		cpu5: cpu@500 {
			device_type = "cpu";
			compatible = "arm,cortex-x4";
			reg = <0x500>;
			enable-method = "psci";
			capacity-dmips-mhz = <835>;
			clock-frequency = <2800000000>;
			cpu-idle-states = <&cpuoff_m &clusteroff_m &s2idle>;
			performance-domains = <&performance 1>;
			i-cache-size = <65536>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <65536>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&l2_1>;
			#cooling-cells = <2>;
		};

		cpu6: cpu@600 {
			device_type = "cpu";
			compatible = "arm,cortex-x4";
			reg = <0x600>;
			enable-method = "psci";
			capacity-dmips-mhz = <835>;
			clock-frequency = <2800000000>;
			cpu-idle-states = <&cpuoff_m &clusteroff_m &s2idle>;
			performance-domains = <&performance 1>;
			i-cache-size = <65536>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <65536>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&l2_1>;
			#cooling-cells = <2>;
		};

		cpu7: cpu@700 {
			device_type = "cpu";
			compatible = "arm,cortex-x925";
			reg = <0x700>;
			enable-method = "psci";
			capacity-dmips-mhz = <1024>;
			clock-frequency = <3600000000>;
			cpu-idle-states = <&cpuoff_b &clusteroff_b &s2idle>;
			performance-domains = <&performance 2>;
			i-cache-size = <65536>;
			i-cache-line-size = <64>;
			i-cache-sets = <256>;
			d-cache-size = <65536>;
			d-cache-line-size = <64>;
			d-cache-sets = <256>;
			next-level-cache = <&l2_2>;
			#cooling-cells = <2>;
		};

		cpu-map {
			cluster0 {
				core0 {
					cpu = <&cpu0>;
				};
				core1 {
					cpu = <&cpu1>;
				};
				core2 {
					cpu = <&cpu2>;
				};
				core3 {
					cpu = <&cpu3>;
				};
			};

			cluster1 {
				core0 {
					cpu = <&cpu4>;
				};
				core1 {
					cpu = <&cpu5>;
				};
				core2 {
					cpu = <&cpu6>;
				};
			};

			cluster2 {
				core0 {
					cpu = <&cpu7>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpuoff_l: cpuoff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010000>;
				local-timer-stop;
				entry-latency-us = <97>;
				exit-latency-us = <252>;
				min-residency-us = <6710>;
			};

			cpuoff_m: cpuoff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010000>;
				local-timer-stop;
				entry-latency-us = <53>;
				exit-latency-us = <143>;
				min-residency-us = <2120>;
			};

			cpuoff_b: cpuoff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x00010000>;
				local-timer-stop;
				entry-latency-us = <40>;
				exit-latency-us = <107>;
				min-residency-us = <2580>;
			};

			clusteroff_l: clusteroff-l {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010001>;
				local-timer-stop;
				entry-latency-us = <109>;
				exit-latency-us = <325>;
				min-residency-us = <6710>;
			};

			clusteroff_m: clusteroff-m {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010001>;
				local-timer-stop;
				entry-latency-us = <59>;
				exit-latency-us = <188>;
				min-residency-us = <2120>;
			};

			clusteroff_b: clusteroff-b {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x01010001>;
				local-timer-stop;
				entry-latency-us = <43>;
				exit-latency-us = <138>;
				min-residency-us = <2580>;
			};

			s2idle: s2idle {
				compatible = "arm,idle-state";
				arm,psci-suspend-param = <0x020180ff>;
				local-timer-stop;
				entry-latency-us = <10000>;
				exit-latency-us = <10000>;
				min-residency-us = <6400000>;
			};
		};

		l2_0: l2-cache0 {
			compatible = "cache";
			cache-level = <2>;
			cache-size = <524288>;
			cache-line-size = <64>;
			cache-sets = <2048>;
			next-level-cache = <&l3_0>;
			cache-unified;
		};

		l2_1: l2-cache1 {
			compatible = "cache";
			cache-level = <2>;
			cache-size = <1048576>;
			cache-line-size = <64>;
			cache-sets = <4096>;
			next-level-cache = <&l3_0>;
			cache-unified;
		};

		l2_2: l2-cache2 {
			compatible = "cache";
			cache-level = <2>;
			cache-size = <2097152>;
			cache-line-size = <64>;
			cache-sets = <8192>;
			next-level-cache = <&l3_0>;
			cache-unified;
		};

		l3_0: l3-cache {
			compatible = "cache";
			cache-level = <3>;
			cache-size = <12582912>;
			cache-line-size = <64>;
			cache-sets = <49152>;
			cache-unified;
		};
	};

	firmware {
		optee {
			compatible = "linaro,optee-tz";
			method = "smc";
			interrupts-extended = <&gic GIC_SPI 955 IRQ_TYPE_LEVEL_HIGH 0>;
		};

		scmi {
			compatible = "arm,scmi";
			mboxes = <&tinysys_mbox_tx 0>, <&tinysys_mbox_rx 0>;
			mbox-names = "tx", "rx";
			shmem = <&scmi_tx_shmem>, <&scmi_rx_shmem>;
			#address-cells = <1>;
			#size-cells = <0>;

			scmi_tinysys: protocol@80 {
				reg = <0x80>;
			};
		};
	};

	clk13m: fixed-factor-clock-13m {
		compatible = "fixed-factor-clock";
		#clock-cells = <0>;
		clocks = <&clk26m>;
		clock-div = <2>;
		clock-mult = <1>;
		clock-output-names = "clk13m";
	};

	clk32k: oscillator-32k {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <32000>;
		clock-output-names = "clk32k";
	};

	/* clk26m/104m may be turned off by firmware for deep sleep */
	clk26m: oscillator-26m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "clk26m";
	};

	ufs_opp_table: opp-table-ufs {
		compatible = "operating-points-v2";

		opp-499200000 {
			opp-hz = /bits/ 64 <499200000>, /bits/ 64 <0>,
				 /bits/ 64 <0>, /bits/ 64 <0>, /bits/ 64 <0>,
				 /bits/ 64 <0>, /bits/ 64 <0>, /bits/ 64 <0>,
				 /bits/ 64 <0>, /bits/ 64 <0>, /bits/ 64 <0>,
				 /bits/ 64 <0>, /bits/ 64 <0>, /bits/ 64 <0>,
				 /bits/ 64 <0>, /bits/ 64 <0>;
		};

		opp-273000000 {
			opp-hz = /bits/ 64 <273000000>, /bits/ 64 <0>,
				 /bits/ 64 <0>, /bits/ 64 <0>, /bits/ 64 <0>,
				 /bits/ 64 <0>, /bits/ 64 <0>, /bits/ 64 <0>,
				 /bits/ 64 <0>, /bits/ 64 <0>, /bits/ 64 <0>,
				 /bits/ 64 <0>, /bits/ 64 <0>, /bits/ 64 <0>,
				 /bits/ 64 <0>, /bits/ 64 <0>;
		};
	};

	oscillator-104m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <104000000>;
		clock-output-names = "clk104m";
	};

	/* Ultra Low Power Oscillators used in deeper sleep states */
	oscillator-ulp-520m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <520000000>;
		clock-output-names = "ulposc";
	};

	oscillator-ulp-26m {
		compatible = "fixed-clock";
		#clock-cells = <0>;
		clock-frequency = <26000000>;
		clock-output-names = "ulposc3";
	};

	pmu-hunter {
		compatible = "arm,cortex-a720-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH &ppi_cluster0>;
	};

	pmu-hunter-elp {
		compatible = "arm,cortex-x4-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH &ppi_cluster1>;
	};

	pmu-blackhawk {
		compatible = "arm,cortex-x925-pmu";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 7 IRQ_TYPE_LEVEL_HIGH &ppi_cluster2>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		dma-ranges = <0x0 0x0 0x0 0x0 0x10 0x0>;

		performance: performance-controller@c220400 {
			compatible = "mediatek,mt8196-cpufreq-hw";
			reg = <0 0xc220400 0 0x20>, <0 0xc2c0f20 0 0x120>,
			      <0 0xc2c1040 0 0x120>, <0 0xc2c1160 0 0x120>;
			#performance-domain-cells = <1>;
		};

		lvts_mcu: thermal-sensor@c230000 {
			compatible = "mediatek,mt8196-lvts-mcu";
			reg = <0 0x0c230000 0 0x1000>;
			interrupts = <GIC_SPI 104 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>;
			nvmem-cells = <&lvts_efuse_data1 &lvts_efuse_data2
				       &lvts_efuse_data3 &lvts_efuse_data4>;
			nvmem-cell-names = "lvts-calib-data-1","lvts-calib-data-2",
					   "lvts-calib-data-3","lvts-calib-data-4";
			#thermal-sensor-cells = <1>;
		};

		gic: interrupt-controller@c400000 {
			compatible = "arm,gic-v3";
			reg = <0 0xc400000 0 0x40000>, <0 0xc440000 0 0x200000>;
			interrupt-parent = <&gic>;
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH 0>;
			interrupt-controller;
			#interrupt-cells = <4>;
			#redistributor-regions = <1>;

			ppi-partitions {
				ppi_cluster0: interrupt-partition-0 {
					affinity = <&cpu0 &cpu1 &cpu2 &cpu3>;
				};

				ppi_cluster1: interrupt-partition-1 {
					affinity = <&cpu4 &cpu5 &cpu6>;
				};

				ppi_cluster2: interrupt-partition-2 {
					affinity = <&cpu7>;
				};
			};
		};

		topckgen: clock-controller@10000000 {
			compatible = "mediatek,mt8196-topckgen", "syscon";
			reg = <0 0x10000000 0 0x800>;
			mediatek,hardware-voter = <&scp_hwv>;
			#clock-cells = <1>;
		};

		apmixedsys: clock-controller@10000800 {
			compatible = "mediatek,mt8196-apmixedsys", "syscon";
			reg = <0 0x10000800 0 0x1000>;
			#clock-cells = <1>;
		};

		topckgen_gp2: clock-controller@1000c000 {
			compatible = "mediatek,mt8196-topckgen-gp2", "syscon";
			reg = <0 0x1000c000 0 0x800>;
			mediatek,hardware-voter = <&hfrpsys_hwv>;
			#clock-cells = <1>;
		};

		apmixedsys_gp2: clock-controller@1000c800 {
			compatible = "mediatek,mt8196-apmixedsys-gp2", "syscon";
			reg = <0 0x1000c800 0 0x1000>;
			#clock-cells = <1>;
		};

		infra_bus: bus@1002c000 {
			compatible = "simple-bus";
			reg = <0 0x1002c000 0 0x1000>;
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			#access-controller-cells = <0>;
		};

		pio: pinctrl@1002d000 {
			compatible = "mediatek,mt8196-pinctrl";
			reg = <0 0x1002d000 0 0x1000>, <0 0x12000000 0 0x1000>,
			      <0 0x12020000 0 0x1000>, <0 0x12040000 0 0x1000>,
			      <0 0x12060000 0 0x1000>, <0 0x12820000 0 0x1000>,
			      <0 0x12840000 0 0x1000>, <0 0x12860000 0 0x1000>,
			      <0 0x13000000 0 0x1000>, <0 0x13020000 0 0x1000>,
			      <0 0x13040000 0 0x1000>, <0 0x130f0000 0 0x1000>,
			      <0 0x13110000 0 0x1000>, <0 0x13800000 0 0x1000>,
			      <0 0x13820000 0 0x1000>, <0 0x13860000 0 0x1000>,
			      <0 0x12080000 0 0x1000>, <0 0x12880000 0 0x1000>,
			      <0 0x13080000 0 0x1000>, <0 0x13880000 0 0x1000>,
			      <0 0x1c54a000 0 0x1000>;
			reg-names = "base", "rt", "rm1", "rm2", "rb", "bm1",
				    "bm2", "bm3", "lt", "lm1", "lm2", "lb1",
				    "lb2", "tm1", "tm2", "tm3", "eint0",
				    "eint1", "eint2", "eint3", "eint4";
			gpio-controller;
			#gpio-cells = <2>;
			gpio-ranges = <&pio 0 0 271>;
			interrupt-controller;
			interrupts = <GIC_SPI 396 IRQ_TYPE_LEVEL_HIGH 0>;
			#interrupt-cells = <2>;
			mediatek,rsel-resistance-in-si-unit;
		};

		i2c5: i2c@120a0000 {
			compatible = "mediatek,mt8196-i2c", "mediatek,mt8188-i2c";
			reg = <0 0x120a0000 0 0x20000>, <0 0x16400000 0 0x10000>;
			interrupts = <GIC_SPI 341 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&imp_iic_wrap_east CLK_IMPE_I2C5>,
				 <&pericfg_ao CLK_PERI_AO_AP_DMA_X32W_BCLK>;
			clock-names = "main", "dma";
			clock-div = <1>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		imp_iic_wrap_east: clock-controller@120c0000 {
			compatible = "mediatek,mt8196-imp-iic-wrap-e", "syscon";
			reg = <0 0x120c0000 0 0x1000>;
			#clock-cells = <1>;
		};

		edp_phy: phy@130a0000 {
			compatible = "mediatek,mt8196-edp-phy";
			reg = <0 0x130a0000 0 0x1500>;
			#phy-cells = <0>;
			status = "disabled";

			nvmem-cells = <&edp_glb_bias_trim>, <&edp_clktx_impsel>,
				      <&edp_imp_ln0_pmos>, <&edp_imp_ln0_nmos>,
				      <&edp_imp_ln1_pmos>, <&edp_imp_ln1_nmos>,
				      <&edp_imp_ln2_pmos>, <&edp_imp_ln2_nmos>,
				      <&edp_imp_ln3_pmos>, <&edp_imp_ln3_nmos>;
			nvmem-cell-names = "rbias-trim", "impedance-txclk",
					   "impedance-lane0p", "impedance-lane0n",
					   "impedance-lane1p", "impedance-lane1n",
					   "impedance-lane2p", "impedance-lane2n",
					   "impedance-lane3p", "impedance-lane3n";

			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DISP_EDPTX_DORMANT>;
		};

		mipi_tx_config0: dsi-phy@130b0000 {
			compatible = "mediatek,mt8196-mipi-tx";
			reg = <0 0x130b0000 0 0x1000>;
			clocks = <&clk26m>;
			clock-output-names = "mipi_tx0_pll";
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DSI_PHY0>;
			#clock-cells = <0>;
			#phy-cells = <0>;
			status = "disabled";
		};

		mipi_tx_config1: dsi-phy@130c0000 {
			compatible = "mediatek,mt8196-mipi-tx";
			reg = <0 0x130c0000 0 0x1000>;
			clocks = <&clk26m>;
			clock-output-names = "mipi_tx1_pll";
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DSI_PHY1>;
			#clock-cells = <0>;
			#phy-cells = <0>;
			status = "disabled";
