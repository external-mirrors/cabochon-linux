			compatible = "mediatek,mt8196-i2c", "mediatek,mt8188-i2c";
			reg = <0 0x13190000 0 0x20000>,
			      <0 0x164b0000 0 0x10000>;
			interrupts = <GIC_SPI 344 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&imp_iic_wrap_west CLK_IMPW_I2C10>,
				 <&pericfg_ao CLK_PERI_AO_AP_DMA_X32W_BCLK>;
