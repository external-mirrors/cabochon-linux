				mediatek,larb = <&smi_larb0>;
				trigger-sources = <&ovl0_mutex 2>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						exdma0_2_in: endpoint {
							remote-endpoint = <&ovl0_resizer0_out>;
						};
					};

					port@1 {
						reg = <1>;
						exdma0_2_out: endpoint {
