		imp_iic_wrap_west: clock-controller@131b0000 {
			compatible = "mediatek,mt8196-imp-iic-wrap-w", "syscon";
			reg = <0 0x131b0000 0 0x1000>;
			#clock-cells = <1>;
		};

		efuse: efuse@13260000 {
			compatible = "mediatek,mt8196-efuse", "mediatek,efuse";
			reg = <0 0x13260000 0 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;

			edp_clktx_impsel: edp-dphy-impedance-clk@1b9 {
				reg = <0x1b9 0x1>;
				bits = <1 4>;
			};

			edp_imp_ln3_nmos: edp-dphy-imp-ln3-nmos@1c0,1 {
				reg = <0x1c0 0x1>;
				bits = <0 4>;
			};

			edp_imp_ln3_pmos: edp-dphy-imp-ln3-pmos@1c0,2 {
				reg = <0x1c0 0x1>;
				bits = <4 4>;
			};

			edp_imp_ln2_nmos: edp-dphy-imp-ln2-nmos@1c1,1 {
				reg = <0x1c1 0x1>;
				bits = <0 4>;
			};

			edp_imp_ln2_pmos: edp-dphy-imp-ln2-pmos@1c1,2 {
				reg = <0x1c1 0x1>;
				bits = <4 4>;
			};

			edp_imp_ln1_nmos: edp-dphy-imp-ln1-nmos@1c2,1 {
				reg = <0x1c2 0x1>;
				bits = <0 4>;
			};

			edp_imp_ln1_pmos: edp-dphy-imp-ln1-pmos@1c2,2 {
				reg = <0x1c2 0x1>;
				bits = <4 4>;
			};

			edp_imp_ln0_nmos: edp-dphy-imp-ln0-nmos@1c3,1 {
				reg = <0x1c3 0x1>;
				bits = <0 4>;
			};

			edp_imp_ln0_pmos: edp-dphy-imp-ln0-pmos@1c3,2 {
				reg = <0x1c3 0x1>;
				bits = <4 4>;
			};

			edp_glb_bias_trim: edp-dphy-rbias@1c7 {
				reg = <0x1c7 0x1>;
				bits = <3 5>;
			};

			lvts_efuse_data1: lvts1_calib@334 {
				reg = <0x334 0xc>;
			};

			lvts_efuse_data2: lvts2_calib@340 {
				reg = <0x340 0x14>;
			};

			lvts_efuse_data3: lvts3_calib@354 {
				reg = <0x354 0x20>;
			};

			lvts_efuse_data4: lvts4_calib@388 {
				reg = <0x388 0x20>;
			};
		};

