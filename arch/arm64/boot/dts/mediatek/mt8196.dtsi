				};
			};
		};

		cpu4-0-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_mcu MT8196_MCU_MEDIUM_CPU4_0>;
			trips {
				cpu4_0_crit: trip-crit {
					temperature = <118800>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		cpu4-1-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_mcu MT8196_MCU_MEDIUM_CPU4_1>;
			trips {
				cpu4_1_crit: trip-crit {
					temperature = <118800>;
					hysteresis = <2000>;
