					};

					port@1 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <1>;

						ovl1_resizer0_out: endpoint@2 {
							reg = <2>;
							remote-endpoint = <&exdma1_2_in>;
						};
					};
				};
			};

			ovl1_rsz1: resizer@1e0000 {
				compatible = "mediatek,mt8196-disp-rsz";
				reg = <0 0x1e0000 0 0x1000>;
				clocks = <&ovlsys1 CLK_OVL1_OVL_MDP_RSZ1>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_OVL1_DORMANT>;
				trigger-sources = <&ovl1_mutex 27>;
				status = "disabled";
			};
		};

		vdecsys_soc: clock-controller@3600f000 {
			compatible = "mediatek,mt8196-vdecsys-soc";
			reg = <0 0x3600f000 0 0x1000>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_VDE0>;
			mediatek,hardware-voter = <&hfrpsys_hwv>;
			#clock-cells = <1>;
		};

		vdecsys1: clock-controller@3602f000 {
			compatible = "mediatek,mt8196-vdecsys";
			reg = <0 0x3602f000 0 0x1000>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_VDE1>;
			mediatek,hardware-voter = <&hfrpsys_hwv>;
			#clock-cells = <1>;
		};

		vencsys0: clock-controller@38000000 {
			compatible = "mediatek,mt8196-vencsys";
			reg = <0 0x38000000 0 0x1000>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_VEN0>;
			mediatek,hardware-voter = <&hfrpsys_hwv>;
			#clock-cells = <1>;
		};

		vencsys1: clock-controller@38800000 {
			compatible = "mediatek,mt8196-vencsys-c1";
			reg = <0 0x38800000 0 0x1000>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_VEN1>;
			mediatek,hardware-voter = <&hfrpsys_hwv>;
			#clock-cells = <1>;
		};

		vencsys2: clock-controller@38c00000 {
			compatible = "mediatek,mt8196-vencsys-c2";
			reg = <0 0x38c00000 0 0x1000>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_VEN2>;
			mediatek,hardware-voter = <&hfrpsys_hwv>;
			#clock-cells = <1>;
		};

		mdpsys0: clock-controller@3e000000 {
			compatible = "mediatek,mt8196-mdpsys0";
			reg = <0 0x3e000000 0 0x1000>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_MML0_SHUTDOWN>;
			#clock-cells = <1>;
		};

		mdpsys1: clock-controller@3e400000 {
			compatible = "mediatek,mt8196-mdpsys1";
			reg = <0 0x3e400000 0 0x1000>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_MML1_SHUTDOWN>;
			#clock-cells = <1>;
		};

		vdisp_ao: clock-controller@3e800000 {
			compatible = "mediatek,mt8196-vdisp-ao";
			reg = <0 0x3e800000 0 0x1000>;
			mediatek,hardware-voter = <&hfrpsys_hwv>;
			#clock-cells = <1>;
		};

		edp_tx: displayport-controller@3ec42000 {
			compatible = "mediatek,mt8196-edp-tx";
			reg = <0 0x3ec42000 0 0x3000>,  <0 0x3ec40000 0 0x1000>;
			phys = <&edp_phy>;
			power-domains = <&hpm MT8196_POWER_DOMAIN_EDPTX>;
			max-linkrate-mhz = <8100>;
			interrupts = <GIC_SPI 448 IRQ_TYPE_LEVEL_HIGH 0>;
			status = "disabled";
		};
	};

	sound: mt8196-sound {
		mediatek,platform = <&afe>;
		status = "disabled";
	};

	thermal_zones: thermal-zones {
		cpu6-0-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_mcu MT8196_MCU_MEDIUM_CPU6_0>;
			trips {
				cpu6_0_crit: trip-crit {
					temperature = <118800>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		cpu6-1-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_mcu MT8196_MCU_MEDIUM_CPU6_1>;
