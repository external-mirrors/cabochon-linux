			phys = <&ufsphy>;

			operating-points-v2 = <&ufs_opp_table>;

			resets = <&ufs_ao_clk MT8196_UFSAO_RST1_UFS_UNIPRO>,
				 <&ufs_ao_clk MT8196_UFSAO_RST1_UFS_CRYPTO>,
				 <&ufs_ao_clk MT8196_UFSAO_RST1_UFSHCI>;
			reset-names = "unipro",
				      "crypto",
				      "hci";
			mediatek,ufs-disable-mcq;
			status = "disabled";
		};

		ufs_ao_clk: clock-controller@168a0000 {
			compatible = "mediatek,mt8196-ufscfg-ao", "syscon";
			reg = <0 0x168a0000 0 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		pciephy0: phy@16900000 {
			compatible = "mediatek,mt8196-pcie-sphy";
			reg = <0 0x16900000 0 0x10000>, <0 0x16920000 0 0x10000>;
			reg-names = "sif", "ckm";
			power-domains = <&spm MT8196_POWER_DOMAIN_PEXTP_PHY0>;
			#phy-cells = <0>;
			status = "disabled";
		};

		pcie0: pcie@16910000 {
			compatible = "mediatek,mt8196-pcie";
			device_type = "pci";
			reg = <0 0x16910000 0 0x4000>;
			reg-names = "pcie-mac";
			interrupts = <GIC_SPI 337 IRQ_TYPE_LEVEL_HIGH 0>;
			#address-cells = <3>;
			#size-cells = <2>;
			#interrupt-cells = <1>;
			bus-range = <0x00 0xff>;
			ranges = <0x82000000 0 0x50000000 0x0 0x50000000 0 0x8000000>;

			clocks = <&pextp0cfg_ao CLK_PEXT_PEXTP_MAC_P0_PL_P>,
				 <&pextp0cfg_ao CLK_PEXT_PEXTP_MAC_P0_TL>,
				 <&pextp0cfg_ao CLK_PEXT_PEXTP_MAC_P0_AHB_APB>,
				 <&pextp0cfg_ao CLK_PEXT_PEXTP_VLP_AO_P0_LP>,
				 <&pextp0cfg_ao CLK_PEXT_PEXTP_MAC_P0_REF>,
				 <&pextp0cfg_ao CLK_PEXT_PEXTP_MAC_P0_AXI_250>;
			clock-names = "pl_250m", "tl_26m", "bus", "low_power",
				      "peri_26m", "peri_mem";
			assigned-clocks = <&topckgen CLK_TOP_TL>;
			assigned-clock-parents = <&topckgen CLK_TOP_MAINPLL_D4_D4>;

			phys = <&pciephy0>;
			phy-names = "pcie-phy";

			power-domains = <&spm MT8196_POWER_DOMAIN_PEXTP_MAC0>;
			resets = <&pextp0cfg_ao MT8196_PEXTP0_RST0_PCIE0_PHY>,
				 <&pextp0cfg_ao MT8196_PEXTP0_RST0_PCIE0_MAC>;
			reset-names = "phy", "mac";

			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &pcie0_intc 0>,
					<0 0 0 2 &pcie0_intc 1>,
					<0 0 0 3 &pcie0_intc 2>,
					<0 0 0 4 &pcie0_intc 3>;
			status = "disabled";

			pcie0_intc: interrupt-controller {
				interrupt-controller;
				#address-cells = <0>;
				#interrupt-cells = <1>;
			};
		};

		pciephy1: phy@16930000 {
			compatible = "mediatek,mt8196-pcie-sphy";
			reg = <0 0x16930000 0 0x10000>, <0 0x16950000 0 0x10000>;
			reg-names = "sif", "ckm";
			power-domains = <&spm MT8196_POWER_DOMAIN_PEXTP_PHY1>;
			num-lanes = <2>;
			#phy-cells = <0>;
			status = "disabled";
		};

		pcie1: pcie@16940000 {
			compatible = "mediatek,mt8196-pcie";
			device_type = "pci";
			reg = <0 0x16940000 0 0x4000>;
			reg-names = "pcie-mac";
			interrupts = <GIC_SPI 338 IRQ_TYPE_LEVEL_HIGH 0>;
			#address-cells = <3>;
			#size-cells = <2>;
			#interrupt-cells = <1>;
			bus-range = <0x00 0xff>;
			ranges = <0x82000000 0 0x58000000 0x0 0x58000000 0 0x18000000>;

			clocks = <&pextp1cfg_ao CLK_PEXT1_PEXTP_MAC_P1_PL_P>,
				 <&pextp1cfg_ao CLK_PEXT1_PEXTP_MAC_P1_TL>,
				 <&pextp1cfg_ao CLK_PEXT1_PEXTP_MAC_P1_AHB_APB>,
				 <&pextp1cfg_ao CLK_PEXT1_PEXTP_VLP_AO_P1_LP>,
				 <&pextp1cfg_ao CLK_PEXT1_PEXTP_MAC_P1_REF>,
				 <&pextp1cfg_ao CLK_PEXT1_PEXTP_MAC_P1_AXI_250>;
			clock-names = "pl_250m", "tl_26m", "bus", "low_power",
				      "peri_26m", "peri_mem";
			assigned-clocks = <&topckgen CLK_TOP_TL_P1>;
			assigned-clock-parents = <&topckgen CLK_TOP_MAINPLL_D4_D4>;

			phys = <&pciephy1>;
			phy-names = "pcie-phy";

			power-domains = <&spm MT8196_POWER_DOMAIN_PEXTP_MAC1>;
			resets = <&pextp1cfg_ao MT8196_PEXTP1_RST0_PCIE1_PHY>,
				 <&pextp1cfg_ao MT8196_PEXTP1_RST0_PCIE1_MAC>;
			reset-names = "phy", "mac";

			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &pcie1_intc 0>,
					<0 0 0 2 &pcie1_intc 1>,
					<0 0 0 3 &pcie1_intc 2>,
					<0 0 0 4 &pcie1_intc 3>;
			status = "disabled";

			pcie1_intc: interrupt-controller {
				interrupt-controller;
				#address-cells = <0>;
				#interrupt-cells = <1>;
			};
		};

		pciephy2: phy@16960000 {
			compatible = "mediatek,mt8196-pcie-sphy";
			reg = <0 0x16960000 0 0x10000>, <0 0x16980000 0 0x10000>;
			reg-names = "sif", "ckm";
			power-domains = <&spm MT8196_POWER_DOMAIN_PEXTP_PHY2>;
			#phy-cells = <0>;
			status = "disabled";
		};

		pcie2: pcie@16970000 {
			compatible = "mediatek,mt8196-pcie";
			device_type = "pci";
			reg = <0 0x16970000 0 0x4000>;
			reg-names = "pcie-mac";
			#address-cells = <3>;
			#size-cells = <2>;
			#interrupt-cells = <1>;
			interrupts = <GIC_SPI 339 IRQ_TYPE_LEVEL_HIGH 0>;
			bus-range = <0x00 0xff>;
			ranges = <0x82000000 0 0x70000000 0x0 0x70000000 0 0x8000000>;

			clocks = <&pextp1cfg_ao CLK_PEXT1_PEXTP_MAC_P2_PL_P>,
				 <&pextp1cfg_ao CLK_PEXT1_PEXTP_MAC_P2_TL>,
				 <&pextp1cfg_ao CLK_PEXT1_PEXTP_MAC_P2_AHB_APB>,
				 <&pextp1cfg_ao CLK_PEXT1_PEXTP_VLP_AO_P2_LP>,
				 <&pextp1cfg_ao CLK_PEXT1_PEXTP_MAC_P2_REF>,
				 <&pextp1cfg_ao CLK_PEXT1_PEXTP_MAC_P2_AXI_250>;
			clock-names = "pl_250m", "tl_26m", "bus", "low_power",
				      "peri_26m", "peri_mem";
			assigned-clocks = <&topckgen CLK_TOP_TL_P2>;
			assigned-clock-parents = <&topckgen CLK_TOP_MAINPLL_D4_D4>;

			phys = <&pciephy2>;
			phy-names = "pcie-phy";

			power-domains = <&spm MT8196_POWER_DOMAIN_PEXTP_MAC2>;
			resets = <&pextp1cfg_ao MT8196_PEXTP1_RST0_PCIE2_PHY>,
				 <&pextp1cfg_ao MT8196_PEXTP1_RST0_PCIE2_MAC>;
			reset-names = "phy", "mac";

			interrupt-map-mask = <0 0 0 7>;
			interrupt-map = <0 0 0 1 &pcie2_intc 0>,
					<0 0 0 2 &pcie2_intc 1>,
					<0 0 0 3 &pcie2_intc 2>,
					<0 0 0 4 &pcie2_intc 3>;
			status = "disabled";

			pcie2_intc: interrupt-controller {
				interrupt-controller;
				#address-cells = <0>;
				#interrupt-cells = <1>;
			};
		};

		pextp0cfg_ao: clock-controller@169b0000 {
			compatible = "mediatek,mt8196-pextp0cfg-ao", "syscon";
			reg = <0 0x169b0000 0 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		pextp1cfg_ao: clock-controller@169e0000 {
			compatible = "mediatek,mt8196-pextp1cfg-ao", "syscon";
			reg = <0 0x169e0000 0 0x1000>;
			#clock-cells = <1>;
			#reset-cells = <1>;
		};

		afe: mt8196-afe-pcm@1a110000 {
			compatible = "mediatek,mt8196-afe";
			reg = <0 0x1a110000 0 0x9000>;
			interrupts = <GIC_SPI 351 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&vlpckgen CLK_VLP_AUD_INTBUS>,
				 <&vlpckgen CLK_VLP_AUD_ENGEN1>,
				 <&vlpckgen CLK_VLP_AUD_ENGEN2>,
				 <&vlpckgen CLK_VLP_AUDIO_H>,
				 <&vlpckgen CLK_VLP_APLL1>,
				 <&vlpckgen CLK_VLP_APLL2>,
				 <&topckgen CLK_TOP_APLL_I2SIN0>,
				 <&topckgen CLK_TOP_APLL_I2SIN1>,
				 <&topckgen CLK_TOP_APLL_FMI2S>,
				 <&topckgen CLK_TOP_APLL12_DIV_TDMOUT_M>,
				 <&topckgen CLK_TOP_APLL12_DIV_TDMOUT_B>,
				 <&topckgen CLK_TOP_ADSP>;
			clock-names = "top_aud_intbus",
				      "top_aud_eng1",
				      "top_aud_eng2",
				      "top_aud_h",
				      "apll1",
				      "apll2",
				      "apll12_div_i2sin0",
				      "apll12_div_i2sin1",
				      "apll12_div_fmi2s",
				      "apll12_div_tdmout_m",
				      "apll12_div_tdmout_b",
				      "top_adsp";
			power-domains = <&spm MT8196_POWER_DOMAIN_AUDIO>;
			status = "disabled";
		};

		adsp_mailbox0: mailbox@1a350100 {
			compatible = "mediatek,mt8196-adsp-mbox", "mediatek,mt8186-adsp-mbox";
			reg = <0 0x1a350100 0 0x1000>;
			interrupts = <GIC_SPI 709 IRQ_TYPE_LEVEL_HIGH 0>;
			#mbox-cells = <0>;
		};

		adsp_mailbox1: mailbox@1a360100 {
			compatible = "mediatek,mt8196-adsp-mbox","mediatek,mt8186-adsp-mbox";
			reg = <0 0x1a360100 0 0x1000>;
			interrupts = <GIC_SPI 710 IRQ_TYPE_LEVEL_HIGH 0>;
			#mbox-cells = <0>;
		};

		adsp: adsp@1a000000 {
			compatible = "mediatek,mt8196-dsp";
			reg = <0 0x1a000000 0 0x5000>,
			      <0 0x1a210000 0 0x80000>,
			      <0 0x1a345000 0 0x300>,
			      <0 0x1a00f000 0 0x1000>;
			reg-names = "cfg", "sram", "sec", "bus";
			clocks = <&topckgen CLK_TOP_ADSP>,
				 <&clk26m>,
				 <&apmixedsys CLK_APMIXED_ADSPPLL>;
			clock-names = "audiodsp",
				      "sys_clk",
				      "adsppll";
			mboxes = <&adsp_mailbox0>, <&adsp_mailbox1>;
			mbox-names = "rx", "tx";
			power-domains = <&spm MT8196_POWER_DOMAIN_ADSP_TOP_DORMANT>;
			status = "disabled";
		};

		scpsys: system-controller@1c004000 {
			compatible = "mediatek,mt8196-scpsys", "syscon", "simple-mfd";
			reg = <0 0x1c004000 0 0x1000>;

			/* System Power Manager */
			spm: power-controller {
				compatible = "mediatek,mt8196-power-controller";
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <1>;
				access-controllers = <&infra_bus>, <&scp_bus>;

				power-domain@MT8196_POWER_DOMAIN_MD {
					reg = <MT8196_POWER_DOMAIN_MD>;
					#power-domain-cells = <0>;
				};

				power-domain@MT8196_POWER_DOMAIN_CONN {
					reg = <MT8196_POWER_DOMAIN_CONN>;
					#power-domain-cells = <0>;
				};

				power-domain@MT8196_POWER_DOMAIN_PERI_ETHER {
					reg = <MT8196_POWER_DOMAIN_PERI_ETHER>;
					#power-domain-cells = <0>;
					clocks = <&topckgen CLK_TOP_GMAC_125M>;
					clock-names = "bus";
				};

				power-domain@MT8196_POWER_DOMAIN_SSUSB_P0 {
					reg = <MT8196_POWER_DOMAIN_SSUSB_P0>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					power-domain@MT8196_POWER_DOMAIN_SSUSB_DP_PHY_P0 {
						reg = <MT8196_POWER_DOMAIN_SSUSB_DP_PHY_P0>;
						#power-domain-cells = <0>;
					};
				};

				power-domain@MT8196_POWER_DOMAIN_SSUSB_P1 {
					reg = <MT8196_POWER_DOMAIN_SSUSB_P1>;
					#power-domain-cells = <0>;
				};

				power-domain@MT8196_POWER_DOMAIN_SSUSB_P23 {
					reg = <MT8196_POWER_DOMAIN_SSUSB_P23>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					power-domain@MT8196_POWER_DOMAIN_SSUSB_PHY_P2 {
						reg = <MT8196_POWER_DOMAIN_SSUSB_PHY_P2>;
						#power-domain-cells = <0>;
					};
				};

				power-domain@MT8196_POWER_DOMAIN_PEXTP_MAC0 {
					reg = <MT8196_POWER_DOMAIN_PEXTP_MAC0>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					power-domain@MT8196_POWER_DOMAIN_PEXTP_PHY0 {
						reg = <MT8196_POWER_DOMAIN_PEXTP_PHY0>;
						clocks = <&pextp0cfg_ao CLK_PEXT_PEXTP_PHY_P0_MCU_BUS>,
							 <&pextp0cfg_ao CLK_PEXT_PEXTP_PHY_P0_PEXTP_REF>;
						clock-names = "bus", "ref";
						#power-domain-cells = <0>;
					};
				};

				power-domain@MT8196_POWER_DOMAIN_PEXTP_MAC1 {
					reg = <MT8196_POWER_DOMAIN_PEXTP_MAC1>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					power-domain@MT8196_POWER_DOMAIN_PEXTP_PHY1 {
						reg = <MT8196_POWER_DOMAIN_PEXTP_PHY1>;
						clocks = <&pextp1cfg_ao CLK_PEXT1_PEXTP_PHY_P1_MCU_BUS>,
							 <&pextp1cfg_ao CLK_PEXT1_PEXTP_PHY_P1_PEXTP_REF>;
						clock-names = "bus", "ref";
						#power-domain-cells = <0>;
					};
				};

				power-domain@MT8196_POWER_DOMAIN_PEXTP_MAC2 {
					reg = <MT8196_POWER_DOMAIN_PEXTP_MAC2>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					power-domain@MT8196_POWER_DOMAIN_PEXTP_PHY2 {
						reg = <MT8196_POWER_DOMAIN_PEXTP_PHY2>;
						clocks = <&pextp1cfg_ao CLK_PEXT1_PEXTP_PHY_P2_MCU_BUS>,
							 <&pextp1cfg_ao CLK_PEXT1_PEXTP_PHY_P2_PEXTP_REF>;
						clock-names = "bus", "ref";
						#power-domain-cells = <0>;
					};
				};

				power-domain@MT8196_POWER_DOMAIN_ADSP_AO {
					reg = <MT8196_POWER_DOMAIN_ADSP_AO>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					power-domain@MT8196_POWER_DOMAIN_ADSP_INFRA {
						reg = <MT8196_POWER_DOMAIN_ADSP_INFRA>;
						#address-cells = <1>;
						#size-cells = <0>;
						#power-domain-cells = <1>;

						power-domain@MT8196_POWER_DOMAIN_AUDIO {
							reg = <MT8196_POWER_DOMAIN_AUDIO>;
							#power-domain-cells = <0>;
						};

						power-domain@MT8196_POWER_DOMAIN_ADSP_TOP_DORMANT {
							reg = <MT8196_POWER_DOMAIN_ADSP_TOP_DORMANT>;
							#power-domain-cells = <0>;
						};
					};
				};
			};
		};

		scp_bus: bus@1c00d000 {
			compatible = "simple-bus";
			reg = <0 0x1c00d000 0 0x1000>;
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			#access-controller-cells = <0>;
		};

		watchdog@1c010000 {
			compatible = "mediatek,mt8196-wdt", "mediatek,mt6589-wdt";
			reg = <0 0x1c010000 0 0x1000>;
			#reset-cells = <1>;
			mediatek,disable-extrst;
		};

		system-controller@1c013000 {
			compatible = "mediatek,mt8196-dvfsrc";
			reg = <0 0x1c013000 0 0x1000>;
			clocks = <&vlpckgen CLK_VLP_DVFSRC>;

			regulators {
				compatible = "mediatek,mt8196-dvfsrc-regulator";

				dvfsrc_vcore: dvfsrc-vcore {
					regulator-name = "dvfsrc-vcore";
					regulator-min-microvolt = <575000>;
					regulator-max-microvolt = <875000>;
					regulator-always-on;
				};
			};

			emi_icc: interconnect {
				compatible = "mediatek,mt8196-emi";
				#interconnect-cells = <1>;
			};
		};

		vlpckgen: clock-controller@1c016000 {
			compatible = "mediatek,mt8196-vlpckgen", "syscon";
			reg = <0 0x1c016000 0 0x1000>;
			mediatek,hardware-voter = <&scp_hwv>;
			#clock-cells = <1>;
		};

		spmi-arbiter@1c018000 {
			compatible = "mediatek,mt8196-spmi";
			ranges = <0 0 0x1c018000 0x4900>;
			#address-cells = <1>;
			#size-cells = <1>;

			spmi1: spmi@0 {
				reg = <0 0x900>, <0x4800 0x100>;
				reg-names = "pmif", "spmimst";
				interrupts-extended = <&pio 292 IRQ_TYPE_LEVEL_HIGH>;
				interrupt-names = "rcs";
				interrupt-controller;
				#address-cells = <2>;
				#size-cells = <0>;
				#interrupt-cells = <3>;
				clocks = <&clk32k>,
					 <&vlpckgen CLK_VLP_SPMI_M_TIA_32K>,
					 <&vlpckgen CLK_VLP_SPMI_M_MST>;
				clock-names = "pmif_sys_ck", "pmif_tmr_ck", "spmimst_clk_mux";
			};

			spmi0: spmi@2000 {
				reg = <0x2000 0x900>, <0x4000 0x100>;
				reg-names = "pmif", "spmimst";
				interrupts-extended = <&pio 291 IRQ_TYPE_LEVEL_HIGH>;
				interrupt-names = "rcs";
				interrupt-controller;
				#address-cells = <2>;
				#size-cells = <0>;
				#interrupt-cells = <3>;
				clocks = <&clk32k>,
					 <&vlpckgen CLK_VLP_SPMI_M_TIA_32K>,
					 <&vlpckgen CLK_VLP_SPMI_M_MST>;
				clock-names = "pmif_sys_ck", "pmif_tmr_ck", "spmimst_clk_mux";
			};
		};

		sram@1c350000 {
			compatible = "mmio-sram";
			reg = <0x0 0x1c350000 0x0 0x80>;
			ranges = <0 0x0 0x1c350000 0x80>;
			#address-cells = <1>;
			#size-cells = <1>;

			scmi_tx_shmem: scmi-sram-section@0 {
				compatible = "arm,scmi-shmem";
				reg = <0x0 0x80>;
			};
		};

		tinysys_mbox_tx: mailbox@1c351000 {
			compatible = "mediatek,mt8196-tinysys-mhu-mbox";
			reg = <0 0x1c351000 0 0x1000>;
			interrupts = <GIC_SPI 417 IRQ_TYPE_LEVEL_HIGH 0>;
			#mbox-cells = <1>;
		};

		sram@1c360000 {
			compatible = "mmio-sram";
			reg = <0x0 0x1c360000 0x0 0x80>;
			ranges = <0 0x0 0x1c360000 0x80>;
			#address-cells = <1>;
			#size-cells = <1>;

			scmi_rx_shmem: scmi-sram-section@0 {
				compatible = "arm,scmi-shmem";
				reg = <0x0 0x80>;
			};
		};

		tinysys_mbox_rx: mailbox@1c361000 {
			compatible = "mediatek,mt8196-tinysys-mhu-mbox";
			reg = <0 0x1c361000 0 0x1000>;
			interrupts = <GIC_SPI 418 IRQ_TYPE_LEVEL_HIGH 0>;
			#mbox-cells = <1>;
		};

		systimer: systimer@1c400000 {
			compatible = "mediatek,mt8196-timer", "mediatek,mt6765-timer";
			reg = <0 0x1c400000 0 0x1000>;
			interrupts = <GIC_SPI 813 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk13m>;
		};

		gce0: gce@300c0000 {
			compatible = "mediatek,mt8196-gce";
			reg = <0 0x300c0000 0 0x80000>;
			interrupts = <GIC_SPI 483 IRQ_TYPE_LEVEL_HIGH 0>;
			#mbox-cells = <2>;
			iommus = <&mm_smmu 199>; /* remove me */
			mboxes = <&gce0 15 CMDQ_THR_PRIO_1>;
		};

		gce1: gce@30140000 {
			compatible = "mediatek,mt8196-gce";
			reg = <0 0x30140000 0 0x80000>;
			interrupts = <GIC_SPI 482 IRQ_TYPE_LEVEL_HIGH 0>;
			#mbox-cells = <2>;
			iommus = <&mm_smmu 183>; /* remove me */
		};

		/* High Frame Rate Processor System Controller (HFRPSYS) */
		hfrpsys_hwv: system-controller@31b00000 {
			compatible = "mediatek,mt8196-hfrpsys", "syscon", "simple-mfd";
			reg = <0 0x31b00000 0 0x6000>;

			/* HFRPSYS Power Controller with Hardware Voter */
			hpm_hwv: power-controller {
				compatible = "mediatek,mt8196-hwv-hfrp-power-controller";
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <1>;

				/* Power Domains are at end of soc avoiding too far indentation */
			};

			/* HFRPSYS Power Regulators */
			regulators {
				compatible = "mediatek,mt8196-hwv-vmm-regulator";
				//access-controllers = <&vcp>;
				access-controller-names = "vcp";

				vmm_vdisp: vdisp {
					regulator-name = "vdisp";
					regulator-min-microvolt = <575000>;
					regulator-max-microvolt = <875000>;
				};

				vmm_vhwdec: vhwdec {
					regulator-name = "vdec-vcore";
					regulator-min-microvolt = <575000>;
					regulator-max-microvolt = <900000>;
				};
			};
		};

		system-controller@31b50000 {
			compatible = "mediatek,mt8196-hfrpsys", "syscon", "simple-mfd";
			reg = <0 0x31b50000 0 0x1000>;

			/* HFRPSYS Power Manager */
			hpm: power-controller {
				compatible = "mediatek,mt8196-hfrp-power-controller";
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <1>;

				power-domain@MT8196_POWER_DOMAIN_EDPTX {
					reg = <MT8196_POWER_DOMAIN_EDPTX>;
					clocks = <&topckgen_gp2 CLK_TOP2_DVO>;
					clock-names = "power";
					#power-domain-cells = <0>;
				};

				power-domain@MT8196_POWER_DOMAIN_DPTX {
					reg = <MT8196_POWER_DOMAIN_DPTX>;
					#power-domain-cells = <0>;
				};
			};
		};

		dispsys0: display-controller@32000000 {
			compatible = "mediatek,mt8196-dispsys0";
			reg = <0 0x32000000 0 0x1000>;
			mboxes = <&gce0 0 CMDQ_THR_PRIO_4>, <&gce0 1 CMDQ_THR_PRIO_4>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;
			mediatek,hardware-voter = <&hfrpsys_hwv>;
			#address-cells = <2>;
			#clock-cells = <1>;
			#size-cells = <2>;
			ranges = <0 0 0 0x32000000 0 0x200000>;

			direct-link@200 {
				compatible = "mediatek,mt8196-disp-direct-link";
				reg = <0 0x200 0 0x100>;
				clocks = <&dispsys0 CLK_MM_CONFIG>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;
				trigger-sources = <&disp0_mutex 16>, <&disp0_mutex 32>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <0>;

						dl_in_async0_0: endpoint@0 {
							reg = <0>;
							clocks = <&dispsys0 CLK_MM_DISP_DLI_ASYNC0>;
							remote-endpoint = <&ovl_dl_out_async0_5>;
						};

						dl_in_async0_1: endpoint@1 {
							reg = <1>;
							clocks = <&dispsys0 CLK_MM_DISP_DLI_ASYNC1>;
							remote-endpoint = <&ovl_dl_out_async0_6>;
						};

						dl_in_async0_8: endpoint@2 {
							reg = <2>;
							clocks = <&dispsys0 CLK_MM_DISP_DLI_ASYNC8>;
							remote-endpoint = <&dl_out_async0_3>;
							mediatek,port-id = <8>;
						};
					};

					port@1 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <1>;

						dl_out_async0_1: endpoint@0 {
							reg = <0>;
							clocks = <&dispsys0 CLK_MM_DISP_DLO_ASYNC1>;
							remote-endpoint = <&dl_in_async1_1>;
							mediatek,port-id = <1>;
						};

						dl_out_async0_2: endpoint@1 {
							reg = <1>;
							clocks = <&dispsys0 CLK_MM_DISP_DLO_ASYNC2>;
							remote-endpoint = <&dl_in_relay0_1>;
							mediatek,port-id = <2>;
						};

						dl_out_async0_3: endpoint@2 {
							reg = <2>;
							clocks = <&dispsys0 CLK_MM_DISP_DLO_ASYNC3>;
							remote-endpoint = <&dl_in_async0_8>;
							mediatek,port-id = <3>;
						};
					};

					port@2 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <2>;

						dl_in_relay0_0: endpoint@0 {
							reg = <0>;
							remote-endpoint = <&rsz0_in>;
						};

						dl_in_relay0_1: endpoint@1 {
							reg = <1>;
							remote-endpoint = <&dl_out_async0_2>;
						};
					};

					port@3 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <3>;

						dl_out_relay0_1: endpoint@0 {
							reg = <0>;
							remote-endpoint = <&dither0_out>;
							mediatek,port-id = <1>;
						};

					};
				};
			};

			disp0_mutex: mutex@20000 {
				compatible = "mediatek,mt8196-disp-mutex";
				reg = <0 0x20000 0 0x1000>;
				clocks = <&dispsys0 CLK_MM_DISP_MUTEX0>;
				#trigger-source-cells = <1>;
				mediatek,gce-events = <CMDQ_EVENT_DISP1_STREAM_DONE_ENG_EVENT(0)>,
						      <CMDQ_EVENT_DISP1_STREAM_DONE_ENG_EVENT(1)>;
			};

			aal0: aal@30000 {
				compatible = "mediatek,mt8196-disp-aal", "mediatek-mt8183-disp-aal";
				reg = <0 0x30000 0 0x1000>;
				interrupts = <GIC_SPI 475 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&dispsys0 CLK_MM_DISP_AAL0>;
				trigger-sources = <&disp0_mutex 0>;
			};

			aal1: aal@40000 {
				compatible = "mediatek,mt8196-disp-aal", "mediatek-mt8183-disp-aal";
				reg = <0 0x40000 0 0x1000>;
				interrupts = <GIC_SPI 474 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&dispsys0 CLK_MM_DISP_AAL1>;
				trigger-sources = <&disp0_mutex 1>;
			};

			ccorr0: ccorr@90000 {
				compatible = "mediatek,mt8196-disp-ccorr", "mediatek,mt8192-disp-ccorr";
				reg = <0 0x90000 0 0x1000>;
				clocks = <&dispsys0 CLK_MM_DISP_CCORR0>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;
				trigger-sources = <&disp0_mutex 6>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						ccorr0_in: endpoint {
							remote-endpoint = <&tdshp0_out>;
						};
					};

					port@1 {
						reg = <1>;
						ccorr0_out: endpoint {
							remote-endpoint = <&ccorr1_in>;
						};
					};
				};
			};

			ccorr1: ccorr@a0000 {
				compatible = "mediatek,mt8196-disp-ccorr", "mediatek,mt8192-disp-ccorr";
				reg = <0 0xa0000 0 0x1000>;
				clocks = <&dispsys0 CLK_MM_DISP_CCORR1>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;
				trigger-sources = <&disp0_mutex 7>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						ccorr1_in: endpoint {
							remote-endpoint = <&ccorr0_out>;
						};
					};

					port@1 {
						reg = <1>;
						ccorr1_out: endpoint {
							remote-endpoint = <&gamma0_in>;
						};
					};
				};
			};

			ccorr2: ccorr@b0000 {
				compatible = "mediatek,mt8196-disp-ccorr", "mediatek,mt8192-disp-ccorr";
				reg = <0 0xb0000 0 0x1000>;
				clocks = <&dispsys0 CLK_MM_DISP_CCORR2>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;
				trigger-sources = <&disp0_mutex 8>;
			};

			ccorr3: ccorr@c0000 {
				compatible = "mediatek,mt8196-disp-ccorr", "mediatek,mt8192-disp-ccorr";
				reg = <0 0xc0000 0 0x1000>;
				clocks = <&dispsys0 CLK_MM_DISP_CCORR3>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;
				trigger-sources = <&disp0_mutex 9>;
			};

			dither0: dither@110000 {
				compatible = "mediatek,mt8196-disp-dither", "mediatek,mt8183-disp-dither";
				reg = <0 0x110000 0 0x1000>;
				interrupts = <GIC_SPI 471 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&dispsys0 CLK_MM_DISP_DITHER0>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;
				trigger-sources = <&disp0_mutex 14>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						dither0_in: endpoint {
							remote-endpoint = <&postmask0_out>;
						};
					};

					port@1 {
						reg = <1>;
						dither0_out: endpoint {
							remote-endpoint = <&dl_out_relay0_1>;
						};
					};
				};
			};

			dither1: dither@120000 {
				compatible = "mediatek,mt8196-disp-dither", "mediatek,mt8183-disp-dither";
				reg = <0 0x120000 0 0x1000>;
				interrupts = <GIC_SPI 470 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&dispsys0 CLK_MM_DISP_DITHER1>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;
				trigger-sources = <&disp0_mutex 15>;
			};

			gamma0: gamma@130000 {
				compatible = "mediatek,mt8196-disp-gamma", "mediatek,mt8195-disp-gamma";
				reg = <0 0x130000 0 0x1000>;
				clocks = <&dispsys0 CLK_MM_DISP_GAMMA0>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;
				trigger-sources = <&disp0_mutex 41>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						gamma0_in: endpoint {
							remote-endpoint = <&ccorr1_out>;
						};
					};

					port@1 {
						reg = <1>;
						gamma0_out: endpoint {
							remote-endpoint = <&postmask0_in>;
						};
					};
				};
			};

			gamma1: gamma@140000 {
				compatible = "mediatek,mt8196-disp-gamma", "mediatek,mt8195-disp-gamma";
				reg = <0 0x140000 0 0x1000>;
				clocks = <&dispsys0 CLK_MM_DISP_GAMMA1>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;
				trigger-sources = <&disp0_mutex 42>;
			};

			tdshp0: tdshp@1e0000 {
				compatible = "mediatek,mt8196-disp-tdshp";
				reg = <0 0x1e0000 0 0x1000>;
				clocks = <&dispsys0 CLK_MM_DISP_TDSHP0>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;
				trigger-sources = <&disp0_mutex 53>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						tdshp0_in: endpoint {
							remote-endpoint = <&rsz0_out>;
						};
					};

					port@1 {
						reg = <1>;
						tdshp0_out: endpoint {
							remote-endpoint = <&ccorr0_in>;
						};
					};
				};
			};

			tdshp1: tdshp@1f0000 {
				compatible = "mediatek,mt8196-disp-tdshp";
				reg = <0 0x1f0000 0 0x1000>;
				clocks = <&dispsys0 CLK_MM_DISP_TDSHP1>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;
				trigger-sources = <&disp0_mutex 54>;
			};

			postmask0: postmask@180000 {
				compatible = "mediatek,mt8196-disp-postmask",
					     "mediatek,mt8192-disp-postmask";
				reg = <0 0x180000 0 0x1000>;
				clocks = <&dispsys0 CLK_MM_DISP_POSTMASK0>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						postmask0_in: endpoint {
							remote-endpoint = <&gamma0_out>;
						};
					};

					port@1 {
						reg = <1>;
						postmask0_out: endpoint {
							remote-endpoint = <&dither0_in>;
						};
					};
				};
			};

			postmask1: postmask@190000 {
				compatible = "mediatek,mt8196-disp-postmask",
					     "mediatek,mt8192-disp-postmask";
				reg = <0 0x190000 0 0x1000>;
				clocks = <&dispsys0 CLK_MM_DISP_POSTMASK1>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;
			};

			mdp_rsz0: resizer@1a0000 {
				compatible = "mediatek,mt8196-disp-rsz";
				reg = <0 0x1a0000 0 0x1000>;
				clocks = <&dispsys0 CLK_MM_MDP_RSZ0>;
				trigger-sources = <&disp0_mutex 50>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						reg = <0>;
						rsz0_in: endpoint {
							remote-endpoint = <&dl_in_relay0_0>;
						};
					};

					port@1 {
						reg = <1>;
						rsz0_out: endpoint {
							remote-endpoint = <&tdshp0_in>;
						};
					};
				};
			};

			mdp_rsz1: resizer@1b0000 {
				compatible = "mediatek,mt8196-disp-rsz";
				reg = <0 0x1b0000 0 0x1000>;
				clocks = <&dispsys0 CLK_MM_MDP_RSZ1>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;
				trigger-sources = <&disp0_mutex 51>;
			};
		};

		dispsys1: display-controller@32400000 {
			compatible = "mediatek,mt8196-dispsys1";
			reg = <0 0x32400000 0 0x1000>;
			ranges = <0 0 0 0x32400000 0 0x200000>;
			#address-cells = <2>;
			#clock-cells = <1>;
			#size-cells = <2>;
			mboxes = <&gce0 0 CMDQ_THR_PRIO_4>, <&gce0 1 CMDQ_THR_PRIO_4>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS1_DORMANT>;
			mediatek,hardware-voter = <&hfrpsys_hwv>;

			direct-link@200 {
				compatible = "mediatek,mt8196-disp-direct-link";
				reg = <0 0x200 0 0x100>;
				clocks = <&dispsys1 CLK_MM1_DISPSYS1_CONFIG>;
				trigger-sources = <&disp1_mutex 0>, <&disp1_mutex 0>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <0>;

						dl_in_async1_1: endpoint@0 {
							reg = <0>;
							clocks = <&dispsys1 CLK_MM1_DISP_DLI_ASYNC21>;
							remote-endpoint = <&dl_out_async0_1>;
							mediatek,port-id = <1>;
						};
/*
						dl_in_async1_2: endpoint@1 {
							reg = <1>;
							clocks = <&dispsys1 CLK_MM1_DISP_DLI_ASYNC22>;
							//remote-endpoint = <&dsc0_in>;
							mediatek,port-id = <2>;
						};
*/
						dl_in_async1_3: endpoint@2 {
							reg = <2>;
							clocks = <&dispsys1 CLK_MM1_DISP_DLI_ASYNC23>;
							remote-endpoint = <&ovl_dl_out_async1_5>;
							mediatek,port-id = <3>;
						};
					};

					port@1 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <1>;

						dl_out_async1_0: endpoint@0 {
							reg = <0>;
							clocks = <&dispsys1 CLK_MM1_DISPSYS1_CONFIG>;
							mediatek,port-id = <1>;
						};
/*
						dl_out_async1_1: endpoint@1 {
							reg = <1>;
							clocks = <&dispsys1 CLK_MM1_DISPSYS1_CONFIG>;
							mediatek,port-id = <1>;
						};
*/
					};

					port@2 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <2>;

						dl_in_relay1_1: endpoint@0 {
							reg = <0>;
							remote-endpoint = <&dvo0_in>;
							mediatek,port-id = <1>;
						};
/*
						dl_in_relay1_2: endpoint@1 {
							reg = <1>;
							//remote-endpoint = <&dsc0_in>;
							mediatek,port-id = <2>;
						};
*/
						dl_in_relay1_3: endpoint@2 {
							reg = <2>;
							remote-endpoint = <&dsc1_in>;
							mediatek,port-id = <3>;
						};
					};

					port@3 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <3>;

						dl_out_relay1_1: endpoint@0 {
							reg = <0>;
						};
/*
						dl_out_relay1_2: endpoint@1 {
							reg = <1>;
						};
*/
					};
				};
			};

			disp1_mutex: mutex@20000 {
				compatible = "mediatek,mt8196-disp-mutex";
				reg = <0 0x20000 0 0x1000>;
				clocks = <&dispsys1 CLK_MM1_DISP_MUTEX0>;
				#trigger-source-cells = <1>;
			};

			dp_intf0: displayport-interface@30000 {
				compatible = "mediatek,mt8196-dp-intf";
				reg = <0 0x30000 0 0x1000>;
				interrupts = <GIC_SPI 460 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&topckgen_gp2 CLK_TOP2_DP0>,
					 <&dispsys1 CLK_MM1_DISP_DP_INTF0>,
					 <&apmixedsys_gp2 CLK_APMIXED2_TVDPLL1>;
				clock-names = "pixel", "engine", "pll";
				power-domains = <&hpm MT8196_POWER_DOMAIN_DPTX>;
				trigger-sources = <&disp1_mutex 13>;
				status = "fail";
			};

			dp_intf1: displayport-interface@40000 {
				compatible = "mediatek,mt8196-dp-intf";
				reg = <0 0x40000 0 0x1000>;
				interrupts = <GIC_SPI 464 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&topckgen_gp2 CLK_TOP2_DP1>,
					 <&dispsys1 CLK_MM1_DISP_DP_INTF1>,
					 <&apmixedsys_gp2 CLK_APMIXED2_TVDPLL2>;
				clock-names = "pixel", "engine", "pll";
				power-domains = <&hpm MT8196_POWER_DOMAIN_EDPTX>;
				trigger-sources = <&disp1_mutex 14>;
				status = "fail";
			};

			dsc0: dsc@50000 {
				compatible = "mediatek,mt8196-disp-dsc", "mediatek,mt8195-disp-dsc";
				reg = <0 0x50000 0 0x1000>;
				clocks = <&dispsys1 CLK_MM1_DISP_DSC_WRAP0>;
				trigger-sources = <&disp1_mutex 15>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <0>;

						dsc0_in: endpoint@1 { reg = <1>; };
					};

					port@1 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <1>;

						dsc0_out: endpoint@1 { reg = <1>; };
					};
				};
			};

			dsc1: dsc@60000 {
				compatible = "mediatek,mt8196-disp-dsc", "mediatek,mt8195-disp-dsc";
				reg = <0 0x60000 0 0x1000>;
				clocks = <&dispsys1 CLK_MM1_DISP_DSC_WRAP1>;
				trigger-sources = <&disp1_mutex 17>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <0>;

						dsc1_in: endpoint@2 {
							reg = <2>;
							remote-endpoint = <&dl_in_relay1_3>;
						};
					};

					port@1 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <1>;

						dsc1_out: endpoint@2 { reg = <2>; };
					};
				};
			};

			dsc2: dsc@70000 {
				compatible = "mediatek,mt8196-disp-dsc", "mediatek,mt8195-disp-dsc";
				reg = <0 0x70000 0 0x1000>;
				clocks = <&dispsys1 CLK_MM1_DISP_DSC_WRAP2>;
				trigger-sources = <&disp1_mutex 19>;
			};

			dsc3: dsc@80000 {
				compatible = "mediatek,mt8196-disp-dsc", "mediatek,mt8195-disp-dsc";
				reg = <0 0x80000 0 0x1000>;
				clocks = <&dispsys1 CLK_MM1_DISP_DSC_WRAP3>;
				trigger-sources = <&disp1_mutex 21>;
			};

			dsi0: dsi@90000 {
				compatible = "mediatek,mt8196-dsi";
				reg = <0 0x90000 0 0x1000>;
				interrupts = <GIC_SPI 453 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&dispsys1 CLK_MM1_DISP_DSI0>,
					 <&dispsys1 CLK_MM1_MOD1>,
					 <&mipi_tx_config0>;
				clock-names = "engine", "digital", "hs";
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DSI_PHY0>;
				phys = <&mipi_tx_config0>;
				phy-names = "dphy";
				trigger-sources = <&disp1_mutex 23>;
				status = "disabled";
			};

			dsi1: dsi@a0000 {
				compatible = "mediatek,mt8196-dsi";
				reg = <0 0x90000 0 0x1000>;
				interrupts = <GIC_SPI 455 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&dispsys1 CLK_MM1_DISP_DSI1>,
					 <&dispsys1 CLK_MM1_MOD2>,
					 <&mipi_tx_config1>;
				clock-names = "engine", "digital", "hs";
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DSI_PHY1>;
				phys = <&mipi_tx_config1>;
				phy-names = "dphy";
				trigger-sources = <&disp1_mutex 25>;
				status = "disabled";
			};

			dsi2: dsi@b0000 {
				compatible = "mediatek,mt8196-dsi";
				reg = <0 0x90000 0 0x1000>;
				interrupts = <GIC_SPI 455 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&dispsys1 CLK_MM1_DISP_DSI2>,
					 <&dispsys1 CLK_MM1_MOD3>,
					 <&mipi_tx_config2>;
				clock-names = "engine", "digital", "hs";
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DSI_PHY2>;
				phys = <&mipi_tx_config2>;
				phy-names = "dphy";
				trigger-sources = <&disp1_mutex 27>;
				status = "disabled";
			};

			dvo0: dvo@c0000 {
				compatible = "mediatek,mt8196-edp-dvo"; /* Digital Video Out */
				reg = <0 0xc0000 0 0x1000>;
				interrupts = <GIC_SPI 461 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&dispsys1 CLK_MM1_DISP_DVO0>,
					 <&dispsys1 CLK_MM1_MOD6>,
					 <&apmixedsys_gp2 CLK_APMIXED2_TVDPLL3>;
				clock-names = "pixel", "engine", "pll";
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_DIS0_DORMANT>;
				trigger-sources = <&disp1_mutex 29>;
				status = "disabled";

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <0>;

						dvo0_in: endpoint@0 {
							reg = <0>;
							remote-endpoint = <&dl_in_relay1_1>;
						};
					};

					port@1 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <1>;

						dvo0_out: endpoint@0 { reg = <0>; };
					};
				};
			};

			disp1_dither2: dither@130000 {
				compatible = "mediatek,mt8196-disp-dither", "mediatek,mt8183-disp-dither";
				reg = <0 0x130000 0 0x1000>;
				interrupts = <GIC_SPI 469 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&dispsys1 CLK_MM1_DISP_DITHER2>;
				trigger-sources = <&disp1_mutex 36>;
			};
		};

		ovlsys0: display-controller@32800000 {
			compatible = "mediatek,mt8196-ovlsys0";
			reg = <0 0x32800000 0 0x1000>;
			mboxes = <&gce0 0 CMDQ_THR_PRIO_4>, <&gce0 1 CMDQ_THR_PRIO_4>,
				 <&gce0 8 CMDQ_THR_PRIO_4>, <&gce0 9 CMDQ_THR_PRIO_4>;
			power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_OVL0_DORMANT>;
			mediatek,hardware-voter = <&hfrpsys_hwv>;
			#address-cells = <2>;
			#clock-cells = <1>;
			#size-cells = <2>;
			ranges = <0 0 0 0x32800000 0 0x200000>;

			port {
				#address-cells = <1>;
				#size-cells = <0>;

				ovlsys0_ep_main: endpoint@0 {
					reg = <0>;
					remote-endpoint = <&ovl0_resizer0_in>;
				};
/*
				ovlsys0_ep_ext: endpoint@1 {
					reg = <1>;
					remote-endpoint = <&exdma0_6_in>;
				};
*/
			};

			direct-link@260 {
				compatible = "mediatek,mt8196-ovl-direct-link";
				reg = <0 0x260 0 0x100>;
				clocks = <&ovlsys0 CLK_OVLSYS_CONFIG>;
				power-domains = <&hpm_hwv MT8196_POWER_DOMAIN_OVL0_DORMANT>;
				trigger-sources = <&ovl0_mutex 34>, <&ovl0_mutex 43>;

				ports {
					#address-cells = <1>;
					#size-cells = <0>;

					port@0 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <0>;

						ovl_dl_in_async0_0: endpoint@0 {
							reg = <0>;
							clocks = <&ovlsys0 CLK_OVL_DLI0>;
							mediatek,port-id = <5>;
						};

						ovl_dl_in_async0_1: endpoint@1 {
							reg = <1>;
							clocks = <&ovlsys0 CLK_OVL_DLI1>;
							mediatek,port-id = <6>;
						};
					};

					port@1 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <1>;

						ovl_dl_out_async0_5: endpoint@0 {
							reg = <0>;
							clocks = <&ovlsys0 CLK_OVL_DLO5>;
							remote-endpoint = <&dl_in_async0_0>;
							mediatek,port-id = <5>;
						};

						ovl_dl_out_async0_6: endpoint@1 {
							reg = <1>;
							clocks = <&ovlsys0 CLK_OVL_DLO6>;
							remote-endpoint = <&dl_in_async0_1>;
							mediatek,port-id = <6>;
						};
					};

					port@2 { /* IN relay */
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <2>;
					};

					port@3 {
						#address-cells = <1>;
						#size-cells = <0>;
						reg = <3>;

						ovl_dl_out_relay0_5: endpoint@0 {
							reg = <0>;
							remote-endpoint = <&outproc0_0_out>;
							mediatek,port-id = <5>;
						};

						ovl_dl_out_relay0_6: endpoint@1 {
							reg = <1>;
							remote-endpoint = <&outproc0_1_out>;
							mediatek,port-id = <6>;
						};
					};
				};
			};

			ovl0_mutex: mutex@20000 {
				compatible = "mediatek,mt8196-disp-mutex";
				reg = <0 0x20000 0 0x1000>;
				clocks = <&ovlsys0 CLK_OVL_MUTEX0>;
				#trigger-source-cells = <1>;
				mediatek,gce-events = <CMDQ_EVENT_DISP1_STREAM_DONE_ENG_EVENT(0)>,
						      <CMDQ_EVENT_DISP1_STREAM_DONE_ENG_EVENT(1)>;
			};

			ovl0_exdma2: dma-controller@50000 {
				compatible = "mediatek,mt8196-disp-exdma";
