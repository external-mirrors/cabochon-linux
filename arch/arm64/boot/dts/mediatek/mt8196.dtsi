	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_HIGH 0>;
		clock-frequency = <13000000>;
	};
};

/* High Frame Rate Processor System Controller (HFRPSYS) Power Domains */
&hpm_hwv {
	power-domain@MT8196_POWER_DOMAIN_DSI_PHY0 {
		reg = <MT8196_POWER_DOMAIN_DSI_PHY0>;
		#power-domain-cells = <0>;
	};

	power-domain@MT8196_POWER_DOMAIN_DSI_PHY1 {
		reg = <MT8196_POWER_DOMAIN_DSI_PHY1>;
		#power-domain-cells = <0>;
	};

	power-domain@MT8196_POWER_DOMAIN_DSI_PHY2 {
		reg = <MT8196_POWER_DOMAIN_DSI_PHY2>;
		#power-domain-cells = <0>;
	};

	power-domain@MT8196_POWER_DOMAIN_MM_INFRA_AO {
		reg = <MT8196_POWER_DOMAIN_MM_INFRA_AO>;
		#address-cells = <1>;
		#size-cells = <0>;
		#power-domain-cells = <0>;

		power-domain@MT8196_POWER_DOMAIN_MM_INFRA0 {
			reg = <MT8196_POWER_DOMAIN_MM_INFRA0>;
			#address-cells = <1>;
			#size-cells = <0>;
			#power-domain-cells = <0>;

			power-domain@MT8196_POWER_DOMAIN_MM_INFRA1 {
				reg = <MT8196_POWER_DOMAIN_MM_INFRA1>;
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <0>;

				power-domain@MT8196_POWER_DOMAIN_CSI_BS_RX {
					reg = <MT8196_POWER_DOMAIN_CSI_BS_RX>;
					#power-domain-cells = <0>;
				};

				power-domain@MT8196_POWER_DOMAIN_CSI_LS_RX {
					reg = <MT8196_POWER_DOMAIN_CSI_LS_RX>;
					#power-domain-cells = <0>;
				};

				power-domain@MT8196_POWER_DOMAIN_DISP_VCORE {
					reg = <MT8196_POWER_DOMAIN_DISP_VCORE>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <0>;

					power-domain@MT8196_POWER_DOMAIN_DIS0_DORMANT {
						reg = <MT8196_POWER_DOMAIN_DIS0_DORMANT>;
						clocks = <&vdisp_ao CLK_MM_V_DISP_VDISP_AO_CONFIG>,
							 <&vdisp_ao CLK_MM_V_DISP_DPC>;
						clock-names = "cfg", "dpc";
						#power-domain-cells = <0>;
					};

					power-domain@MT8196_POWER_DOMAIN_DIS1_DORMANT {
						reg = <MT8196_POWER_DOMAIN_DIS1_DORMANT>;
						clocks = <&vdisp_ao CLK_MM_V_DISP_VDISP_AO_CONFIG>,
							 <&vdisp_ao CLK_MM_V_DISP_DPC>;
						clock-names = "cfg", "dpc";
						#power-domain-cells = <0>;
					};

					power-domain@MT8196_POWER_DOMAIN_DISP_EDPTX_DORMANT {
						reg = <MT8196_POWER_DOMAIN_DISP_EDPTX_DORMANT>;
						clocks = <&vdisp_ao CLK_MM_V_DISP_VDISP_AO_CONFIG>,
							 <&vdisp_ao CLK_MM_V_DISP_DPC>;
						clock-names = "cfg", "dpc";
						#power-domain-cells = <0>;
					};

					power-domain@MT8196_POWER_DOMAIN_DISP_DPTX_DORMANT {
						reg = <MT8196_POWER_DOMAIN_DISP_DPTX_DORMANT>;
						clocks = <&vdisp_ao CLK_MM_V_DISP_VDISP_AO_CONFIG>,
							 <&vdisp_ao CLK_MM_V_DISP_DPC>;
						clock-names = "cfg", "dpc";
						#power-domain-cells = <0>;
					};

					power-domain@MT8196_POWER_DOMAIN_OVL0_DORMANT {
						reg = <MT8196_POWER_DOMAIN_OVL0_DORMANT>;
						clocks = <&vdisp_ao CLK_MM_V_DISP_VDISP_AO_CONFIG>,
							 <&vdisp_ao CLK_MM_V_DISP_DPC>;
						clock-names = "cfg", "dpc";
						#power-domain-cells = <0>;
					};

					power-domain@MT8196_POWER_DOMAIN_OVL1_DORMANT {
						reg = <MT8196_POWER_DOMAIN_OVL1_DORMANT>;
						clocks = <&vdisp_ao CLK_MM_V_DISP_VDISP_AO_CONFIG>,
							 <&vdisp_ao CLK_MM_V_DISP_DPC>;
						clock-names = "cfg", "dpc";
						#power-domain-cells = <0>;
					};

					power-domain@MT8196_POWER_DOMAIN_MML0_SHUTDOWN {
						reg = <MT8196_POWER_DOMAIN_MML0_SHUTDOWN>;
						#power-domain-cells = <0>;
					};

					power-domain@MT8196_POWER_DOMAIN_MML1_SHUTDOWN {
						reg = <MT8196_POWER_DOMAIN_MML1_SHUTDOWN>;
						#power-domain-cells = <0>;
					};
				};

				power-domain@MT8196_POWER_DOMAIN_VDE_VCORE0 {
					reg = <MT8196_POWER_DOMAIN_VDE_VCORE0>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <0>;

					power-domain@MT8196_POWER_DOMAIN_VDE0 {
						reg = <MT8196_POWER_DOMAIN_VDE0>;
						#power-domain-cells = <0>;
					};

					power-domain@MT8196_POWER_DOMAIN_VDE1 {
						reg = <MT8196_POWER_DOMAIN_VDE1>;
						#power-domain-cells = <0>;
					};
				};

				power-domain@MT8196_POWER_DOMAIN_VEN0 {
					reg = <MT8196_POWER_DOMAIN_VEN0>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <0>;

					power-domain@MT8196_POWER_DOMAIN_VEN1 {
						reg = <MT8196_POWER_DOMAIN_VEN1>;
						#address-cells = <1>;
						#size-cells = <0>;
						#power-domain-cells = <0>;

						power-domain@MT8196_POWER_DOMAIN_VEN2 {
							reg = <MT8196_POWER_DOMAIN_VEN2>;
							#power-domain-cells = <0>;
						};
					};
				};
			};
		};
	};
};

#include "mt8196-downstream.dtsi"
#include "mt8196-iommu.dtsi"
