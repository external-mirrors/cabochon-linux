					temperature = <118800>;
					hysteresis = <2000>;
					type = "critical";
				};
			};
		};

		soc-top2-thermal {
			polling-delay = <1000>;
			thermal-sensors = <&lvts_ap MT8196_AP_TOP2>;
			trips {
				soc_top2_crit: trip-crit {
