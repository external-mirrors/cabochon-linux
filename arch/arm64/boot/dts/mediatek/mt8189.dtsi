				 <&peri_ao CLK_PERAO_PWM_B>,
				 <&peri_ao CLK_PERAO_PWM_FB1>,
				 <&peri_ao CLK_PERAO_PWM_FB2>,
				 <&peri_ao CLK_PERAO_PWM_FB3>;
			clock-names = "top", "main", "pwm1", "pwm2", "pwm3";
			#pwm-cells = <2>;
			status = "disabled";
