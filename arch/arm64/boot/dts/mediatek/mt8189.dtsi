			reg = <0 0x1cc06000 0 0x0008ff>, <0 0x1cc00000 0 0x000100>;
			reg-names = "pmif", "spmimst";
			clocks = <&vlpcfg CLK_VLPCFG_REG_PMIF_SPMI_P_SYS>,
				 <&vlpcfg CLK_VLPCFG_REG_PMIF_SPMI_P_TMR>,
				 <&vlpckgen CLK_VLP_CK_SPMI_P_MST_SEL>;
			clock-names = "pmif_sys_ck", "pmif_tmr_ck", "spmimst_clk_mux";
			#address-cells = <2>;
			#size-cells = <0>;
		};

		scpsys: syscon@1c001000 {
			compatible = "mediatek,mt8189-scpsys", "syscon", "simple-mfd";
			reg = <0 0x1c001000 0 0x1000>;

			/* System Power Manager */
			spm: power-controller {
				compatible = "mediatek,mt8189-power-controller";
				#address-cells = <1>;
				#size-cells = <0>;
				#power-domain-cells = <1>;

				mfg0: power-domain@MT8189_POWER_DOMAIN_MFG0 {
					reg = <MT8189_POWER_DOMAIN_MFG0>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					mfg1: power-domain@MT8189_POWER_DOMAIN_MFG1 {
						reg = <MT8189_POWER_DOMAIN_MFG1>;
						clocks = <&apmixedsys CLK_APMIXED_MFGPLL>,
							 <&topckgen CLK_TOP_MFG_REF_SEL>;
						clock-names = "mfg", "alt";
						#address-cells = <1>;
						#size-cells = <0>;
						#power-domain-cells = <1>;
						mediatek,infracfg = <&infra_ao>;
						mediatek,smi = <&emicfg_ao_mem>;

						power-domain@MT8189_POWER_DOMAIN_MFG2 {
							reg = <MT8189_POWER_DOMAIN_MFG2>;
							#power-domain-cells = <0>;
						};

						power-domain@MT8189_POWER_DOMAIN_MFG3 {
							reg = <MT8189_POWER_DOMAIN_MFG3>;
							#power-domain-cells = <0>;
						};
					};
				};

				/* power domain of the SoC */
				power-domain@MT8189_POWER_DOMAIN_CONN {
					reg = <MT8189_POWER_DOMAIN_CONN>;
					mediatek,infracfg = <&infra_ao>;
					#power-domain-cells = <0>;
				};

				power-domain@MT8189_POWER_DOMAIN_AUDIO {
					reg = <MT8189_POWER_DOMAIN_AUDIO>;
					clocks = <&topckgen CLK_TOP_AUD_INTBUS_SEL>;
					clock-names = "audio";
					mediatek,infracfg = <&infra_ao>;
					#power-domain-cells = <0>;
				};

				power-domain@MT8189_POWER_DOMAIN_ADSP_AO {
					reg = <MT8189_POWER_DOMAIN_ADSP_AO>;
					clocks = <&vlpckgen CLK_VLP_CK_VADSP_SEL>;
					clock-names = "vadsp";
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					power-domain@MT8189_POWER_DOMAIN_ADSP_INFRA {
						reg = <MT8189_POWER_DOMAIN_ADSP_INFRA>;
						#address-cells = <1>;
						#size-cells = <0>;
						#power-domain-cells = <1>;

						power-domain@MT8189_POWER_DOMAIN_ADSP_TOP_DORMANT {
							reg = <MT8189_POWER_DOMAIN_ADSP_TOP_DORMANT>;
							#power-domain-cells = <0>;
						};
					};
				};

				power-domain@MT8189_POWER_DOMAIN_MM_INFRA {
					reg = <MT8189_POWER_DOMAIN_MM_INFRA>;
					clocks = <&topckgen CLK_TOP_MMINFRA_SEL>,
						 <&mminfra CLK_MMINFRA_SMI>;
					clock-names = "mminfra", "ss-mminfra";
					mediatek,infracfg = <&infra_ao>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					power-domain@MT8189_POWER_DOMAIN_ISP_IMG1 {
						reg = <MT8189_POWER_DOMAIN_ISP_IMG1>;
						clocks = <&topckgen CLK_TOP_IMG1_SEL>,
							 <&imgsys1 CLK_IMGSYS1_LARB9>,
							 <&imgsys1 CLK_IMGSYS1_LARB11>,
							 <&imgsys1 CLK_IMGSYS1_GALS>;
						clock-names = "img1", "ss-img1-0", "ss-img1-1", "ss-img1-2";
						mediatek,infracfg = <&infra_ao>;
						#address-cells = <1>;
						#size-cells = <0>;
						#power-domain-cells = <1>;

						power-domain@MT8189_POWER_DOMAIN_ISP_IMG2 {
							reg = <MT8189_POWER_DOMAIN_ISP_IMG2>;
							clocks = <&imgsys2 CLK_IMGSYS2_LARB9>,
								 <&imgsys2 CLK_IMGSYS2_LARB11>,
								 <&imgsys2 CLK_IMGSYS2_GALS>;
							clock-names = "ss-img2-0", "ss-img2-1", "ss-img2-2";
							#power-domain-cells = <0>;
						};
					};

					power-domain@MT8189_POWER_DOMAIN_ISP_IPE {
						reg = <MT8189_POWER_DOMAIN_ISP_IPE>;
						clocks = <&topckgen CLK_TOP_IPE_SEL>,
							 <&ipesys CLK_IPE_LARB19>,
							 <&ipesys CLK_IPE_LARB20>,
							 <&ipesys CLK_IPE_SMI_SUBCOM>,
							 <&ipesys CLK_IPESYS_GALS>;
						clock-names = "ipe", "ss-ipe0", "ss-ipe1", "ss-ipe2", "ss-ipe3";
						mediatek,infracfg = <&infra_ao>;
						#power-domain-cells = <0>;
					};

					power-domain@MT8189_POWER_DOMAIN_VDE0 {
						reg = <MT8189_POWER_DOMAIN_VDE0>;
						clocks = <&topckgen CLK_TOP_VDEC_SEL>,
							 <&vdec_core CLK_VDEC_CORE_LARB_CKEN>;
						clock-names = "vdec", "ss-vdec";
						mediatek,infracfg = <&infra_ao>;
						#power-domain-cells = <0>;
					};

					power-domain@MT8189_POWER_DOMAIN_VEN0 {
						reg = <MT8189_POWER_DOMAIN_VEN0>;
						clocks = <&topckgen CLK_TOP_VENC_SEL>,
							 <&venc_gcon CLK_VEN1_CKE0_LARB>;
						clock-names = "venc", "ss-venc";
						mediatek,infracfg = <&infra_ao>;
						#power-domain-cells = <0>;
					};

					power-domain@MT8189_POWER_DOMAIN_CAM_MAIN {
						reg = <MT8189_POWER_DOMAIN_CAM_MAIN>;
						clocks = <&topckgen CLK_TOP_CAM_SEL>,
							 <&camsys_main CLK_CAM_M_LARB13>,
							 <&camsys_main CLK_CAM_M_LARB14>,
							 <&camsys_main CLK_CAM_M_CAM2MM_GALS>;
						clock-names = "cam", "ss-cam0", "ss-cam1", "ss-cam2";
						mediatek,infracfg = <&infra_ao>;
						#address-cells = <1>;
						#size-cells = <0>;
						#power-domain-cells = <1>;

						power-domain@MT8189_POWER_DOMAIN_CAM_SUBA {
							reg = <MT8189_POWER_DOMAIN_CAM_SUBA>;
							clocks = <&camsys_rawa CLK_CAM_RA_CAMSYS_RAWA_LARBX>;
							clock-names = "ss-cam-suba";
							#power-domain-cells = <0>;
						};

						power-domain@MT8189_POWER_DOMAIN_CAM_SUBB {
							reg = <MT8189_POWER_DOMAIN_CAM_SUBB>;
							clocks = <&camsys_rawb CLK_CAM_RB_CAMSYS_RAWB_LARBX>;
							clock-names = "ss-cam-subb";
							#power-domain-cells = <0>;
						};
					};

					power-domain@MT8189_POWER_DOMAIN_MDP0 {
						reg = <MT8189_POWER_DOMAIN_MDP0>;
						clocks = <&topckgen CLK_TOP_MDP0_SEL>,
							 <&mdpsys CLK_MDP_SMI0>;
						clock-names = "mdp", "ss-mdp";
						mediatek,infracfg = <&infra_ao>;
						#power-domain-cells = <0>;
					};

					power-domain@MT8189_POWER_DOMAIN_DISP {
						reg = <MT8189_POWER_DOMAIN_DISP>;
						clocks = <&topckgen CLK_TOP_DISP0_SEL>,
							 <&dispsys CLK_MM_SMI_LARB>;
						clock-names = "disp", "ss-disp";
						mediatek,infracfg = <&infra_ao>;
						#address-cells = <1>;
						#size-cells = <0>;
						#power-domain-cells = <1>;

						power-domain@MT8189_POWER_DOMAIN_DP_TX {
							reg = <MT8189_POWER_DOMAIN_DP_TX>;
							#address-cells = <1>;
							#size-cells = <0>;
							#power-domain-cells = <1>;

							power-domain@MT8189_POWER_DOMAIN_EDP_TX_DORMANT {
								reg = <MT8189_POWER_DOMAIN_EDP_TX_DORMANT>;
								#power-domain-cells = <0>;
							};
						};
					};
				};

				power-domain@MT8189_POWER_DOMAIN_CSI_RX {
					reg = <MT8189_POWER_DOMAIN_CSI_RX>;
					#power-domain-cells = <0>;
				};

				power-domain@MT8189_POWER_DOMAIN_SSUSB {
					reg = <MT8189_POWER_DOMAIN_SSUSB>;
					mediatek,infracfg = <&infra_ao>;
					#power-domain-cells = <0>;
				};

				power-domain@MT8189_POWER_DOMAIN_PCIE {
					reg = <MT8189_POWER_DOMAIN_PCIE>;
					#address-cells = <1>;
					#size-cells = <0>;
					#power-domain-cells = <1>;

					power-domain@MT8189_POWER_DOMAIN_PCIE_PHY {
						reg = <MT8189_POWER_DOMAIN_PCIE_PHY>;
						#power-domain-cells = <0>;
					};
				};
			};
		};

		ssusb0: usb@11201000 {
			compatible = "mediatek,mt8189-mtu3", "mediatek,mtu3";
			reg = <0 0x11201000 0 0x2e00>, <0 0x11203e00 0 0x0100>;
			reg-names = "mac", "ippc";
			ranges = <0 0 0 0x11200000 0 0x3f00>;

			#address-cells = <2>;
			clocks = <&peri_ao CLK_PERAO_SSUSB0_SYS>,
				 <&peri_ao CLK_PERAO_SSUSB0_REF>,
				 <&peri_ao CLK_PERAO_SSUSB0_H>,
				 <&peri_ao CLK_PERAO_SSUSB0_F>,
				 <&peri_ao CLK_PERAO_SSUSB0_XHCI>,
				 <&peri_ao CLK_PERAO_SSUSB0_FRMCNT>;
			clock-names = "sys_ck", "ref_ck", "mcu_ck",
				      "dma_ck", "xhci_ck", "frmcnt_ck";
			interrupts = <GIC_SPI 384 IRQ_TYPE_LEVEL_HIGH 0>;
			#size-cells = <2>;
			phys = <&u2port0 PHY_TYPE_USB2>, <&u3port0 PHY_TYPE_USB3>;
			power-domains = <&spm MT8189_POWER_DOMAIN_SSUSB>;
			wakeup-source;
			mediatek,syscon-wakeup = <&peri_ao 0x214 110>;
			status = "disabled";

			xhci0: usb@0 {
				compatible =  "mediatek,mt8189-xhci", "mediatek,mtk-xhci";
				reg = <0 0 0 0x1000>;
				reg-names = "mac";
				interrupts = <GIC_SPI 385 IRQ_TYPE_LEVEL_HIGH 0>;
				clocks = <&peri_ao CLK_PERAO_SSUSB0_SYS>;
				clock-names = "sys_ck";
				status = "disabled";
			};
		};

		timer@1cc10000 {
			compatible = "mediatek,mt8189-timer", "mediatek,mt6765-timer";
			reg = <0 0x1cc10000 0 0x1000>;
			clocks = <&clk13m>;
			interrupts = <GIC_SPI 249 IRQ_TYPE_LEVEL_HIGH 0>;
		};

		u2phy1: xs-phy@11e90000 {
			compatible = "mediatek,mt8189-xsphy", "mediatek,xsphy";
			ranges = <0x0 0x0 0x11e90000 0x700>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			u2port1: usb-phy@0 {
				reg = <0x0 0x700>;
				clocks = <&topckgen CLK_TOP_USB2_PHY_RF_P1_EN>;
				clock-names = "ref";
				#phy-cells = <1>;
			};
		};

		u2phy2: xs-phy@11ef0000 {
			compatible = "mediatek,mt8189-xsphy", "mediatek,xsphy";
			ranges = <0x0 0x0 0x11ef0000 0x700>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			u2port2: usb-phy@0 {
				reg = <0 0x700>;
				clocks = <&topckgen CLK_TOP_USB2_PHY_RF_P2_EN>;
				clock-names = "ref";
				#phy-cells = <1>;
			};
		};

		u2phy4: xs-phy@11b10000 {
			compatible = "mediatek,mt8189-xsphy", "mediatek,xsphy";
			ranges = <0x0 0x0 0x11b10000 0x700>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			u2port4: usb-phy@0 {
				reg = <0x0 0x700>;
				clocks = <&topckgen CLK_TOP_USB2_PHY_RF_P4_EN>;
				clock-names = "ref";
				#phy-cells = <1>;
			};
		};

		u3phy0: xs-phy@11e80000 {
			compatible = "mediatek,mt8189-xsphy", "mediatek,xsphy";
			ranges = <0x0 0x0 0x11e80000 0x3900>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			u2port0: usb-phy@0 {
				reg = <0x0 0x400>;
				clocks = <&topckgen CLK_TOP_USB2_PHY_RF_P0_EN>;
				clock-names = "ref";
				#phy-cells = <1>;
			};

			u3port0: usb-phy@3400 {
				reg = <0x3400 0x500>;
				clocks = <&topckgen CLK_TOP_USB2_PHY_RF_P0_EN>;
				clock-names = "ref";
				#phy-cells = <1>;
			};
		};

		u3phy3: t-phy@11b00000 {
			compatible = "mediatek,mt8189-tphy", "mediatek,generic-tphy-v3";
			ranges = <0x0 0x0 0x11b00000 0x1000>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";

			u2port3: usb-phy@0 {
				reg = <0 0x400>;
				clocks = <&topckgen CLK_TOP_USB2_PHY_RF_P3_EN>;
				clock-names = "ref";
				#phy-cells = <1>;
			};

			u3port3: usb-phy@700 {
				reg = <0x700 0x700>;
				clocks = <&topckgen CLK_TOP_USB2_PHY_RF_P3_EN>;
				clock-names = "ref";
				#phy-cells = <1>;
			};
		};

		uart0: serial@11001000 {
			compatible = "mediatek,mt8189-uart", "mediatek,mt6577-uart";
			reg = <0 0x11001000 0 0x1000>;
			interrupts = <GIC_SPI 397 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>, <&peri_ao CLK_PERAO_UART0>;
			clock-names = "baud", "bus";
			dmas = <&apdma 0>, <&apdma 1>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		uart1: serial@11002000 {
			compatible = "mediatek,mt8189-uart", "mediatek,mt6577-uart";
			reg = <0 0x11002000 0 0x1000>;
			interrupts = <GIC_SPI 398 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>, <&peri_ao CLK_PERAO_UART1>;
			clock-names = "baud", "bus";
			dmas = <&apdma 2>, <&apdma 3>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		uart2: serial@11003000 {
			compatible = "mediatek,mt8189-uart", "mediatek,mt6577-uart";
			reg = <0 0x11003000 0 0x1000>;
			interrupts = <GIC_SPI 399 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>, <&peri_ao CLK_PERAO_UART2>;
			clock-names = "baud", "bus";
			dmas = <&apdma 4>, <&apdma 5>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		uart3: serial@11004000 {
			compatible = "mediatek,mt8189-uart", "mediatek,mt6577-uart";
			reg = <0 0x11004000 0 0x1000>;
			interrupts = <GIC_SPI 457 IRQ_TYPE_LEVEL_HIGH 0>;
			clocks = <&clk26m>, <&peri_ao CLK_PERAO_UART3>;
			clock-names = "baud", "bus";
			dmas = <&apdma 6>, <&apdma 7>;
			dma-names = "tx", "rx";
			status = "disabled";
		};

		ufsphy: ufs-phy@112a0000 {
			compatible =  "mediatek,mt8189-ufsphy", "mediatek,mt8183-ufsphy";
			reg = <0 0x112a0000 0 0x10000>;
			clocks = <&ufscfg_ao CLK_UFSCFG_AO_REG_UNIPRO_SYS>,
				 <&ufscfg_ao CLK_UFSCFG_AO_REG_U_SAP_CFG>;
			clock-names = "unipro", "mp";
			#phy-cells = <0>;
			status = "disabled";
		};

		ufshci: ufshci@112b0000 {
			compatible = "mediatek,mt8189-ufshci";
			reg = <0 0x112b0000 0 0x2300>;
			clocks = <&ufscfg_pdn CLK_UFSCFG_REG_UFSHCI_UFS>,
				 <&ufscfg_pdn CLK_UFSCFG_REG_UFSHCI_AES>,
				 <&clk26m>,
				 <&ufscfg_ao CLK_UFSCFG_AO_REG_UNIPRO_SYS>,
				 <&clk26m>,
				 <&ufscfg_ao CLK_UFSCFG_AO_REG_U_PHY_TOP_AHB_S_BUS>,
				 <&ufscfg_ao CLK_UFSCFG_AO_REG_UNIPRO_TX_SYM>,
				 <&ufscfg_pdn CLK_UFSCFG_REG_UFSHCI_U_AXI>,
				 <&topckgen CLK_TOP_AES_UFSFDE_SEL>,
				 <&topckgen CLK_TOP_UNIVPLL_D6>,
				 <&topckgen CLK_TOP_MAINPLL_D4>,
				 <&ufscfg_ao CLK_UFSCFG_AO_REG_UNIPRO_RX_SYM0>,
				 <&ufscfg_ao CLK_UFSCFG_AO_REG_UNIPRO_RX_SYM1>,
				 <&ufscfg_pdn CLK_UFSCFG_REG_UFSHCI_U_AHB>,
				 <&clk26m>,
				 <&topckgen CLK_TOP_MSDCPLL_D2>;
			clock-names = "ufs",
				      "ufs_aes",
				      "ufs_tick",
				      "unipro_sysclk",
				      "unipro_tick",
				      "unipro_mp_bclk",
				      "ufs_tx_symbol",
				      "ufs_mem_sub",
				      "crypt_mux",
				      "crypt_lp",
				      "crypt_perf",
				      "ufs_rx_symbol0",
				      "ufs_rx_symbol1",
				      "ufs_sel",
				      "ufs_sel_min_src",
				      "ufs_sel_max_src";
			interrupts = <GIC_SPI 393 IRQ_TYPE_LEVEL_HIGH 0>;
			operating-points-v2 = <&ufs_opp_table>;
			phys = <&ufsphy>;
			resets = <&ufscfg_pdn MT8189_UFSPDN_RST_UFS_UNIPRO>,
				 <&ufscfg_pdn MT8189_UFSPDN_RST_UFS_CRYPTO>,
				 <&ufscfg_pdn MT8189_UFSPDN_RST_UFS_HCI>;
			reset-names = "unipro", "crypto", "hci";
			mediatek,ufs-disable-mcq;
			status = "disabled";
		};

		xhci1: usb@11210000 {
			compatible =  "mediatek,mt8189-xhci", "mediatek,mtk-xhci";
			reg = <0 0x11210000 0 0x1000>, <0 0x11213e00 0 0x0100>;
			reg-names = "mac", "ippc";

			clocks = <&peri_ao CLK_PERAO_SSUSB1_SYS>,
				 <&peri_ao CLK_PERAO_SSUSB1_REF>,
				 <&peri_ao CLK_PERAO_SSUSB1_H>,
				 <&peri_ao CLK_PERAO_SSUSB1_F>,
				 <&peri_ao CLK_PERAO_SSUSB1_XHCI>,
				 <&peri_ao CLK_PERAO_SSUSB1_FRMCNT>;
			clock-names = "sys_ck", "ref_ck", "mcu_ck",
				      "dma_ck", "xhci_ck", "frmcnt_ck";
			interrupts = <GIC_SPI 386 IRQ_TYPE_LEVEL_HIGH 0>;
			phys = <&u2port1 PHY_TYPE_USB2>;
			power-domains = <&spm MT8189_POWER_DOMAIN_SSUSB>;
			wakeup-source;
			mediatek,syscon-wakeup = <&peri_ao 0x21c 110>;
			status = "disabled";
		};

		xhci2: usb@11220000 {
			compatible =  "mediatek,mt8189-xhci", "mediatek,mtk-xhci";
			reg = <0 0x11220000 0 0x1000>, <0 0x11223e00 0 0x0100>;
			reg-names = "mac", "ippc";

			clocks = <&peri_ao CLK_PERAO_SSUSB2_SYS>,
				 <&peri_ao CLK_PERAO_SSUSB2_REF>,
				 <&peri_ao CLK_PERAO_SSUSB2_H>,
				 <&peri_ao CLK_PERAO_SSUSB2_F>,
				 <&peri_ao CLK_PERAO_SSUSB2_XHCI>,
				 <&peri_ao CLK_PERAO_SSUSB2_FRMCNT>;
			clock-names = "sys_ck", "ref_ck", "mcu_ck",
				      "dma_ck", "xhci_ck", "frmcnt_ck";
			interrupts = <GIC_SPI 472 IRQ_TYPE_LEVEL_HIGH 0>;
			phys = <&u2port2 PHY_TYPE_USB2>;
			power-domains = <&spm MT8189_POWER_DOMAIN_SSUSB>;
			wakeup-source;
			mediatek,syscon-wakeup = <&peri_ao 0x27c 110>;
			status = "disabled";
		};

		xhci3: usb@11260000 {
			compatible =  "mediatek,mt8189-xhci", "mediatek,mtk-xhci";
			reg = <0 0x11260000 0 0x2e00>, <0 0x11263e00 0 0x0100>;
			reg-names = "mac", "ippc";

			clocks = <&peri_ao CLK_PERAO_SSUSB3_SYS>,
				 <&peri_ao CLK_PERAO_SSUSB3_REF>,
				 <&peri_ao CLK_PERAO_SSUSB3_H>,
				 <&peri_ao CLK_PERAO_SSUSB3_F>,
				 <&peri_ao CLK_PERAO_SSUSB3_XHCI>,
				 <&peri_ao CLK_PERAO_SSUSB3_FRMCNT>;
			clock-names = "sys_ck", "ref_ck", "mcu_ck",
				      "dma_ck", "xhci_ck", "frmcnt_ck";
			interrupts = <GIC_SPI 473 IRQ_TYPE_LEVEL_HIGH 0>;
			phys = <&u2port3 PHY_TYPE_USB2>, <&u3port3 PHY_TYPE_USB3>;
			power-domains = <&spm MT8189_POWER_DOMAIN_SSUSB>;
			wakeup-source;
			mediatek,syscon-wakeup = <&peri_ao 0x284 110>;
			status = "disabled";
		};

		xhci4: usb@11270000 {
			compatible = "mediatek,mt8189-xhci", "mediatek,mtk-xhci";
			reg = <0 0x11270000 0 0x1000>, <0 0x11273e00 0 0x0100>;
			reg-names = "mac", "ippc";

			clocks = <&peri_ao CLK_PERAO_SSUSB4_SYS>,
				 <&peri_ao CLK_PERAO_SSUSB4_REF>,
				 <&peri_ao CLK_PERAO_SSUSB4_H>,
				 <&peri_ao CLK_PERAO_SSUSB4_F>,
				 <&peri_ao CLK_PERAO_SSUSB4_XHCI>,
				 <&peri_ao CLK_PERAO_SSUSB4_FRMCNT>;
			clock-names = "sys_ck", "ref_ck", "mcu_ck",
				      "dma_ck", "xhci_ck", "frmcnt_ck";
			interrupts = <GIC_SPI 474 IRQ_TYPE_LEVEL_HIGH 0>;
			phys = <&u2port4 PHY_TYPE_USB2>;
			power-domains = <&spm MT8189_POWER_DOMAIN_SSUSB>;
			wakeup-source;
			mediatek,syscon-wakeup = <&peri_ao 0x28c 110>;
			status = "disabled";
		};

		watchdog@1c00a000 {
			compatible = "mediatek,mt8189-wdt", "mediatek,mt6589-wdt";
			reg = <0 0x1c00a000 0 0x100>;
			#reset-cells = <1>;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic>;
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_HIGH 0>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_HIGH 0>;
	};
};
