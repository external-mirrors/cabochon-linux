			#address-cells = <1>;
			clock-div = <1>;
			clocks = <&iic_wrap_s CLK_IMPS_I2C5>, <&peri_ao CLK_PERAO_DMA_B>;
			clock-names = "main", "dma";
			interrupts = <GIC_SPI 209 IRQ_TYPE_LEVEL_HIGH 0>;
