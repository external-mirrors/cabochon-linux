/dts-v1/;

#include "mt8894-genio-pro-5100-evk-common.dtsi"
#include <dt-bindings/usb/pd.h>

/ {
	model = "MediaTek Genio Pro 5100 EVK SKU2";
	compatible = "mediatek,mt8894-evk-sku2", "mediatek,mt8894",
		     "mediatek,mt8196";
};

&can_clk {
	clock-frequency = <20000000>;
};

&connector_hdmi0_in {
	remote-endpoint = <&it6162_out>;
};

&hdmi_bridge_it6162 {
	interrupts-extended = <&pio 143 IRQ_TYPE_LEVEL_LOW>;

	/* IT6162CFN - Firmware expects DSI on Port 0 */
	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			reg = <0>;
			it6162_in: endpoint {
				/* remote-endpoint = <&dsi0_out>; */
			};
		};

		port@2 {
			reg = <2>;
			it6162_out: endpoint {
				remote-endpoint = <&connector_hdmi0_in>;
			};
		};
	};
};

&hdmi_bridge_pins {
	pins-int {
		pinmux = <PINMUX_GPIO143__FUNC_GPIO143>;
		input-enable;
		bias-disable;
	};

	pins-fwupd {
		pinmux = <PINMUX_GPIO79__FUNC_GPIO79>;
		output-high;
	};
};

&i2c5 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c5_pins>;
	status = "okay";

	/* Richtek RT1715 USB Type-C PD controller */
	rt1715: typec@4e {
		compatible = "richtek,rt1715";
		reg = <0x4e>;
		interrupts-extended = <&pio 141 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&rt1715_pins>;
		vbus-supply = <&vbus_usb0>;
		wakeup-source;

		connector {
			compatible = "usb-c-connector";
			label = "USB-C";
			data-role = "dual";
			power-role = "dual";
			pd-revision = /bits/ 8 <0x03 0x00 0x01 0x08>;
			op-sink-microwatt = <0>;
			sink-pdos = <PDO_FIXED(5000, 0, PDO_FIXED_DUAL_ROLE | PDO_FIXED_USB_COMM | PDO_FIXED_DATA_SWAP)>;
			source-pdos = <PDO_FIXED(5000, 2000, PDO_FIXED_DUAL_ROLE | PDO_FIXED_USB_COMM | PDO_FIXED_DATA_SWAP)>;
			try-power-role = "source";

			altmodes {
				displayport {
					svid = /bits/ 16 <0xff01>;
					vdo = <0x001c1c47>;
				};
			};

			ports {
				#address-cells = <1>;
				#size-cells = <0>;

				port@0 {
					reg = <0>;
					typec_con_hs: endpoint {
						remote-endpoint = <&ssusb0_role_sw>;
					};
				};

				port@1 {
					reg = <1>;
					typec_con_ss: endpoint {
						remote-endpoint = <&xhci_ss_ep>;
					};
				};

				port@2 {
					reg = <2>;
					typec_con_out: endpoint@0 {
						reg = <0>;
						remote-endpoint = <&typec_mux_in>;
					};

					typec_con_dp: endpoint@1 {
						reg = <1>;
						remote-endpoint = <&dptx_out0>;
					};
				};
			};
		};
	};


	usb3_repeater: repeater@4b {
		compatible = "nxp,ptn3222";
		reg = <0x4b>;
		#phy-cells = <0>;
		reset-gpios = <&pio 216 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb3_repeater_pins>;
		vdd3v3-supply = <&mt6373_vusb>;
		vdd1v8-supply = <&mt6363_vio18>;
	};

	usb0_repeater: repeater@4f {
		compatible = "nxp,ptn3222";
		reg = <0x4f>;
		#phy-cells = <0>;
		reset-gpios = <&pio 72 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&usb0_repeater_pins>;
		vdd3v3-supply = <&mt6373_vusb>;
		vdd1v8-supply = <&mt6363_vio18>;
	};

	/*
	 * U5703: TI TS3USBCA410IRSVT USB 3.0/DP SBU orientation switch.
	 * Controls SBU1/SBU2 and DP_AUX lane routing based on plug orientation.
	 * LnA is connected to DP_AUXP/DP_AUXN from the SoC.
	 */
	typec-mux@5d {
		compatible = "ti,ts3usbca4";
		reg = <0x5d>;

		mode-switch;
		orientation-switch;

		enable-gpios = <&pio 142 GPIO_ACTIVE_HIGH>;
		vcc-supply = <&vsys_3v3>;
		pinctrl-names = "default";
		pinctrl-0 = <&typec_mux_pins>;

		port {
			typec_mux_in: endpoint {
				remote-endpoint = <&typec_con_out>;
			};
		};
	};
};

&i2c13 {
	clock-frequency = <400000>;
	pinctrl-names = "default";
	pinctrl-0 = <&i2c13_pins>;
	status = "okay";

	power-monitor@11 {
		compatible = "microchip,pac1934";
		reg = <0x11>;

		#address-cells = <1>;
		#size-cells = <0>;

		channel@1 {
			reg = <0x1>;
			shunt-resistor-micro-ohms = <3750>;
			label = "vsys_s1";
		};

		channel@2 {
			reg = <0x2>;
			shunt-resistor-micro-ohms = <2500>;
			label = "vsys_12v";
		};

		channel@3 {
			reg = <0x3>;
			shunt-resistor-micro-ohms = <5000>;
			label = "vaudio_5v";
		};

		channel@4 {
			reg = <0x4>;
			shunt-resistor-micro-ohms = <5000>;
			label = "vvideo_5v";
		};
	};
};

&pio {
	i2c5_pins: i2c5-pins {
		pins-bus {
			pinmux = <PINMUX_GPIO176__FUNC_SCL5>,
				 <PINMUX_GPIO177__FUNC_SDA5>;
			bias-disable;
			drive-strength = <4>;
		};
	};


	fan_tach_pins: fan-tach-pins {
		tach-pins {
			pinmux = <PINMUX_GPIO38__FUNC_GPIO38>;
			bias-pull-up;
			input-enable;
		};
	};

	vio18_lcm1_pins: vio18-lcm1-default {
		pins-regulator {
			pinmux = <PINMUX_GPIO48__FUNC_GPIO48>;
			bias-pull-up = <10000>;
			drive-strength-microamp = <1000>;
			output-high;
		};
	};

	vio33_tp1_lcm1_pins: vio33-tp1-lcm1-default {
		pins-regulator {
			pinmux = <PINMUX_GPIO168__FUNC_GPIO168>;
			bias-pull-up = <10000>;
			drive-strength-microamp = <1000>;
			output-high;
		};
	};

	vsys_lcm1_pins: vsys-lcm1-default {
		pins-regulator {
			pinmux = <PINMUX_GPIO136__FUNC_GPIO136>;
			bias-pull-up = <MTK_PUPD_SET_R1R0_01>;
			drive-strength = <4>;
			output-high;
		};
	};
};

&soc_fan {
	pinctrl-names = "default";
	pinctrl-0 = <&fan_tach_pins>;
	interrupts-extended = <&pio 38 IRQ_TYPE_EDGE_RISING>;
};

&vio18_lcm1 {
	gpio = <&pio 48 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&vio18_lcm1_pins>;
};

&vio33_tp1_lcm1 {
	gpio = <&pio 168 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&vio33_tp1_lcm1_pins>;
};

&vsys_lcm1 {
	gpio = <&pio 136 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default";
	pinctrl-0 = <&vsys_lcm1_pins>;
};

&vvideo_5v {
	gpio = <&pio 144 GPIO_ACTIVE_HIGH>;
};

&vvideo_5v_pins {
	pins-regulator {
		pinmux = <PINMUX_GPIO144__FUNC_GPIO144>;
		//bias-pull-up = <MTK_PUPD_SET_R1R0_10>; /* 50kOhm PU */
	};
};

#include "mt8894-genio-pro-display-pipeline.dtsi"
