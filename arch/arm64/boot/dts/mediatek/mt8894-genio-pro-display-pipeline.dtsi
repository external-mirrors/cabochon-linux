/*
 * Copyright (C) 2026 Collabora Ltd.
 *
 * This is a temporary DTSI for display bringup. The pipelines
 * will be added to the Genio Pro common DT whenever this is ready
 * for prime time.
 *
 * *** Include this at the end of the Genio Pro DTS ***
 */

/ {
	backlight_lcm1: backlight-lcm1 {
		compatible = "pwm-backlight";
		brightness-levels = <0 1023>;
		default-brightness-level = <576>;
		num-interpolated-steps = <1023>;
		power-supply = <&vio33_tp1_lcm1>;
		pwms = <&disp_pwm0 0 500000>;
	};
};

&gce0 {
	status = "disabled";
};

&gce1 {
	status = "disabled";
};

&vdisp_ctrl {
	status = "okay";
};

&mipi_tx_config0 {
	drive-strength-microamp = <5600>;
	status = "okay";
};

&mipi_tx_config1 {
	status = "okay";
};

/*
 * DSI0 on dispsys lane 1, with the picture-quality blocks bypassed.
 *
 * dispsys0's local segment for this lane normally runs the PQ chain
 * (dl_in_relay0_0 -> rsz0).  Point it at its own DL_OUT instead, exactly as
 * lane 3 does, so the walker resolves a pass-through with no blocks in
 * between; the matching DIRECT_LINK_IN 0 -> DIRECT_LINK_OUT 1 route already
 * exists in mt8196-mmsys.h.  This is the one configuration not yet tried:
 * lane 1 with the full PQ chain stalls at postmask0, and the reference board's
 * negative result for this route came from poking a live pipeline, which a
 * stalled DL async FIFO cannot recover from either way.
 *
 * The DSI0 tail is unchanged - SPLITTER_OUT_CB9 -> COMP_OUT_CB6 ->
 * MERGE_OUT_CB0 -> disp_dsi0_in0, the only DSI0 input that reports ready.
 */
&dl_in_relay0_0 {
	remote-endpoint = <&dl_out_relay0_1>;
};

&dl_out_relay0_1 {
	remote-endpoint = <&dl_in_relay0_0>;
};

&dl_out_async0_1 {
	remote-endpoint = <&dl_in_async1_1>;
};

&dl_in_async1_1 {
	remote-endpoint = <&dl_out_async0_1>;
};

&dl_in_relay0_2 {
	remote-endpoint = <&dl_out_relay0_3>;
};

&dl_out_relay0_3 {
	remote-endpoint = <&dl_in_relay0_2>;
};

&dl_in_relay0_1 {
	remote-endpoint = <&dl_out_relay0_2>;
};

&dl_out_relay0_2 {
	remote-endpoint = <&dl_in_relay0_1>;
};

&dl_in_async1_2 {
	remote-endpoint = <&dl_out_async0_2>;
};

&dl_out_async0_2 {
	remote-endpoint = <&dl_in_async1_2>;
};

/* Final outputs on DISPSYS1 */
&dl_in_relay1_1 {
	remote-endpoint = <&dsi0_in>;
};

&dl_in_relay1_2 {
	remote-endpoint = <&dp_intf0_in>;
};

&dl_in_relay1_3 {
	remote-endpoint = <&dsi1_in>;
};

/* Remove OVL's DLO6 for now */
&ovl_dl_out_async1_6 {
	/delete-property/ remote-endpoint;
};

/*
 * The PQ chain is out of the path, so remove both of its edges on the
 * direct-link node.  Leaving the DL_OUT_RELAY pointing at dither0 makes the
 * walker follow the PQ exit and fail with -ELOOP ("Last component: 7-0"):
 * the lane then has two descriptions of its local segment.  Lane 3, which
 * works, has no DL_OUT_RELAY endpoint at all - only the DL_IN_RELAY
 * self-reference.
 */
&rsz0_in {
	/delete-property/ remote-endpoint;
};

&dither0_out {
	/delete-property/ remote-endpoint;
};

/* eDP DVO */
&dvo0_in {
	/delete-property/ remote-endpoint;
};

/* DSI1 PWM for Backlight */
&disp_pwm0 {
	pinctrl-names = "default";
	pinctrl-0 = <&disp_pwm0_pins>;
	status = "okay";
};

&it6162_in {
	remote-endpoint = <&dsi0_out>;
};

&dsi0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			dsi0_in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&dl_in_relay1_1>;
			};
		};

		port@1 {
			reg = <1>;

			dsi0_out: endpoint {
				remote-endpoint = <&it6162_in>;
			};
		};
	};
};

&dsi1 {
	#address-cells = <1>;
	#size-cells = <0>;
	status = "okay";

	panel@0 {
		compatible = "startek,kd070fhfid078", "himax,hx8279";
		reg = <0>;
		backlight = <&backlight_lcm1>;
		enable-gpios = <&pio 89 GPIO_ACTIVE_HIGH>;
		reset-gpios = <&pio 90 GPIO_ACTIVE_HIGH>;
		iovcc-supply = <&vio18_lcm1>;
		vdd-supply = <&vsys_lcm1>;
		pinctrl-names = "default";
		pinctrl-0 = <&lcm1_default_pins>;

		port {
			dsi_panel_in: endpoint {
				remote-endpoint = <&dsi1_out>;
			};
		};
	};

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			dsi1_in: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&dl_in_relay1_3>;
			};
		};

		/*
		 * mtk_dsi_host_attach() resolves its next bridge from
		 * port@1/endpoint@0, so the IT6162 must be reachable here.
		 */
		port@1 {
			reg = <1>;

			dsi1_out: endpoint {
				remote-endpoint = <&dsi_panel_in>;
			};
		};
	};
};

&dp_phy {
	status = "okay";
};

&dp_intf0 {
	status = "okay";

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			dp_intf0_in: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&dl_in_relay1_2>;
			};
		};

		port@1 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <1>;

			dp_intf0_out: endpoint@1 {
				reg = <1>;
				remote-endpoint = <&dptx_in0>;
			};
		};
	};
};

&dp_tx {
	status = "okay";
	#sound-dai-cells = <0>;

	ports {
		#address-cells = <1>;
		#size-cells = <0>;

		port@0 {
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0>;

			dptx_in0: endpoint@0 {
				reg = <0>;
				remote-endpoint = <&dp_intf0_out>;
			};
		};

		port@1 {
			reg = <1>;
			dptx_out0: endpoint {
				data-lanes = <0 1>;
			};
		};
	};
};

&pio {
	disp_pwm0_pins: disp-pwm0-pins {
		pins-pwm {
			pinmux = <PINMUX_GPIO103__FUNC_DISP_PWM>;
		};
	};

	lcm1_default_pins: lcm1-pins {
		pins-rst {
			pinmux = <PINMUX_GPIO90__FUNC_GPIO90>;
			drive-strength = <8>;
			output-low;
		};

		pins-en {
			pinmux = <PINMUX_GPIO89__FUNC_GPIO89>;
			drive-strength = <8>;
			bias-pull-up;
			output-low;
		};
	};
};
