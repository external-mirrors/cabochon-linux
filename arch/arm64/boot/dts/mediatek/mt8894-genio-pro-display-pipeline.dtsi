/ {
	backlight_lcm1: backlight-lcm1 {
		compatible = "pwm-backlight";
		brightness-levels = <0 1023>;
		default-brightness-level = <576>;
		num-interpolated-steps = <1023>;
		power-supply = <&vddp_lcm1>;
		pwms = <&disp_pwm0 0 500000>;
	};

	vsys_lcm1: regulator-vsys-lcm1 {
		compatible = "regulator-fixed";
		regulator-name = "vsys_lcm1";
		regulator-min-microvolt = <5000000>; /*4.5-7.5V*/
		regulator-max-microvolt = <5000000>;
		enable-active-high;
		gpio = <&pio 91 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vsys_lcm1_pins>;
		vin-supply = <&vvideo_5v>;
		regulator-always-on;
	};

	vddp_lcm1: regulator-vddp-lcm1 {
		compatible = "regulator-fixed";
		regulator-name = "vddp_lcm1";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		enable-active-high;
		gpio = <&pio 92 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&vddp_lcm1_pins>;
		vin-supply = <&vvideo_5v>;
		regulator-always-on;
	};

	iovcc_lcm1: regulator-iovcc-lcm1 {
		compatible = "regulator-fixed";
		regulator-name = "iovcc_lcm1";
		regulator-min-microvolt = <1800000>;
		regulator-max-microvolt = <1800000>;
		enable-active-high;
		gpio = <&pio 93 GPIO_ACTIVE_HIGH>;
		pinctrl-names = "default";
		pinctrl-0 = <&iovcc_lcm1_pins>;
		vin-supply = <&vvideo_5v>;
		regulator-always-on;
	};
};

